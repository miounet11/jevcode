---
import { pick, type Lang } from '../i18n/ui';
import { clusterGroups, clusterText, isCurrent, pageHref } from '../data/cluster';
import * as clusterCopy from '../i18n/pages/cluster';

export interface Props {
  lang: Lang;
  path: string;
  /** map：目录页展示全部说明。band：每页底部的相关入口。 */
  variant?: 'band' | 'map';
}

const { lang, path, variant = 'band' } = Astro.props;
const heading = pick(lang, clusterCopy.heading);
const lead = pick(lang, clusterCopy.lead);

const prefer =
  path.includes('/cases/') ? 'cases'
  : path.includes('/patterns/') || path.includes('/primitives/') || path.includes('/concepts/') || path.includes('/sdk/') || path.includes('/introduction') || path.includes('/quickstart') ? 'learn'
  : path.includes('/pricing') || path.includes('/api/') || path.includes('/scenes') || path.includes('/compare') || path.includes('/try') || path.includes('/playground') ? 'use'
  : 'site';

const groups = [...clusterGroups].sort((a, b) => (a.id === prefer ? -1 : b.id === prefer ? 1 : 0));
---

{variant === 'map' ? (
  <div class="directory">
    {groups.map((group) => (
      <section>
        <h2>{clusterText(lang, group.title)}</h2>
        <ul>
          {group.items.filter((item) => !isCurrent(path, lang, item.href)).map((item) => (
            <li>
              <a href={pageHref(lang, item.href)}>{clusterText(lang, item.title)}</a>
              <p>{clusterText(lang, item.desc)}</p>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </div>
) : (
  <section class="section cluster">
    <div class="wrap">
      <div class="section__head">
        <h2 class="section__title">{heading}</h2>
        <p class="section__lead">{lead}</p>
      </div>
      <div class="cluster__grid">
        {groups.map((group) => (
          <div>
            <h3>{clusterText(lang, group.title)}</h3>
            <ul>
              {group.items.filter((item) => !isCurrent(path, lang, item.href)).map((item) => (
                <li>
                  <a href={pageHref(lang, item.href)}>
                    {clusterText(lang, item.title)}
                    <span>{clusterText(lang, item.desc)}</span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>
)}

<style>
  .cluster { border-top: 1px solid var(--border); }
  .cluster__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 28px 22px;
  }
  .cluster h3 {
    margin: 0 0 8px;
    font-size: 13px;
    font-weight: 600;
    color: var(--fg-dim);
  }
  .cluster ul { list-style: none; margin: 0; padding: 0; }
  .cluster li + li { margin-top: 2px; }
  .cluster a {
    display: block;
    padding: 6px 0;
    color: var(--fg);
    text-decoration: none;
    font-size: 14.5px;
  }
  .cluster a span {
    display: block;
    margin-top: 2px;
    color: var(--fg-dim);
    font-size: 12.5px;
    line-height: 1.45;
  }
  .cluster a:hover { color: var(--accent-strong); }
  .directory section + section { margin-top: 28px; }
  .directory h2 { font-size: 22px; letter-spacing: -0.03em; margin: 0 0 10px; }
  .directory ul { list-style: none; margin: 0; padding: 0; }
  .directory li {
    padding: 10px 0;
    border-bottom: 1px solid var(--border);
  }
  .directory a { color: var(--fg); font-weight: 600; text-decoration: none; }
  .directory a:hover { color: var(--accent-strong); }
  .directory p { margin: 4px 0 0; color: var(--fg-muted); font-size: 14px; }
  @media (max-width: 980px) {
    .cluster__grid { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 640px) {
    .cluster__grid { grid-template-columns: 1fr; }
  }
</style>
