---
import { useTranslations, pick, type Lang } from '../i18n/ui';
import { site, partners } from '../data/site';
import * as tryCopy from '../i18n/pages/try';
import * as mapCopy from '../i18n/pages/map';

export interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const year = new Date().getFullYear();

// 友链描述目前只提供 zh/en，其余语言回退到 en
const partnerDesc = (p: (typeof partners)[number]) => (lang === 'zh' ? p.desc.zh : p.desc.en);
---

<footer class="site-footer">
  <div class="wrap">
    <div class="footer__grid">
      <div class="footer__col">
        <h4>{t('site.name')}</h4>
        <p style="margin:0;max-width:44ch;line-height:1.7;">{t('site.description')}</p>
      </div>

      <div class="footer__col">
        <h4>{t('footer.official')}</h4>
        <ul>
          <li><a href={site.official} rel="nofollow noopener noreferrer" target="_blank">typesafe.ai</a></li>
          <li><a href={site.docs} rel="nofollow noopener noreferrer" target="_blank">docs.typesafe.ai</a></li>
          <li>
            <a href={`/${lang}/ecosystem/`}>{t('footer.ecosystemList')}</a>
          </li>
        </ul>
      </div>

      <div class="footer__col">
        <h4>{t('footer.thisSite')}</h4>
        <ul>
          <li><a href={`/${lang}/introduction/`}>{t('nav.docs')}</a></li>
          <li><a href={`/${lang}/patterns/`}>{t('nav.patterns')}</a></li>
          <li><a href={`/${lang}/cases/use-case-map/`}>{t('nav.ecosystem')}</a></li>
          <li><a href={`/${lang}/sdk/`}>{t('footer.sdks')}</a></li>
          <li><a href={`/${lang}/try/`}>{pick(lang, tryCopy.title)}</a></li>
          <li><a href={`/${lang}/lab/`}>{t('nav.lab')}</a></li>
          <li><a href={`/${lang}/scenes/`}>{t('nav.scenes')}</a></li>
          <li><a href={`/${lang}/pricing/`}>{t('nav.pricing')}</a></li>
          <li><a href={`/${lang}/map/`}>{pick(lang, mapCopy.title)}</a></li>
        </ul>
      </div>

      <div class="footer__col">
        <h4>{t('footer.partners')}</h4>
        <ul class="footer__partners">
          {partners.map((p) => (
            <li>
              <a href={p.url} rel="nofollow noopener noreferrer" target="_blank" title={partnerDesc(p)}>{p.name}</a>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <div class="footer__bottom">
      <span>© {year} {t('site.name')}. {t('footer.rights')}</span>
      <span>{t('footer.legal')} · {t('footer.builtWith')}</span>
    </div>
  </div>
</footer>
