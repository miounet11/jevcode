---
import { languages, useTranslations, defaultLang, htmlLangMap, type Lang } from '../i18n/ui';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Cluster from '../components/Cluster.astro';
import '../styles/global.css';

export interface Props {
  lang: Lang;
  title: string;
  description?: string;
  /** 用于 hreflang 与语言切换。canonical 默认也用它 */
  path: string;
  /** 缺译文的回退页改指向已有语言的 URL，path 仍是当前语言路径 */
  canonicalPath?: string;
  /** 登录、账户、404 不进索引 */
  index?: boolean;
  /** 首页和目录页自己渲染相关链接 */
  cluster?: boolean;
  /** 详情页追加的结构化数据节点，合并进 @graph */
  schema?: Record<string, unknown>[];
}

const { lang, title, description, path, index = true, cluster = true, canonicalPath, schema: extraSchema } = Astro.props;
const t = useTranslations(lang);
const siteName = t('site.name');
const fullTitle = title === siteName ? `${siteName} — ${t('site.tagline')}` : `${title} | ${siteName}`;
const desc = description ?? t('site.description');

const canonical = new URL(canonicalPath ?? path, Astro.site).href;
const altPaths: Record<string, string> = {};
for (const l of Object.keys(languages) as Lang[]) {
  // 去掉已有的语言前缀（任意受支持语言），再拼目标语言
  altPaths[l] = new URL(`/${l}${path.replace(/^\/[a-z]{2}(?=\/|$)/, '')}`, Astro.site).href;
}

const htmlLang = htmlLangMap[lang] ?? lang;
const ogImage = new URL('/img/og.png', Astro.site).href;
const orgId = new URL('/#organization', Astro.site).href;
const appId = new URL('/#software', Astro.site).href;

// Site-wide entities. Kept in one graph so every page carries the organization
// and the product definition without duplicating them in page templates.
const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': orgId,
      name: siteName,
      url: new URL('/', Astro.site).href,
      logo: new URL('/icon-512.png', Astro.site).href,
      description: t('site.description'),
      sameAs: [],
    },
    {
      '@type': 'SoftwareApplication',
      '@id': appId,
      name: 'JevCode',
      applicationCategory: 'DeveloperApplication',
      applicationSubCategory: 'AI model API and console',
      operatingSystem: 'Web',
      url: new URL(`/${lang}/`, Astro.site).href,
      description: t('site.description'),
      publisher: { '@id': orgId },
      offers: {
        '@type': 'Offer',
        price: '0.042',
        priceCurrency: 'USD',
        description: 'USD per 1 million input tokens; output tokens are free.',
        category: 'usage-based',
      },
      featureList: [
        'Structured judgment API for the clavue-jev model',
        'Browser playground with 20 anonymous requests per IP per hour',
        'Coverage lab and daily case corpus',
        'SDK and HTTP API references in 8 languages',
      ],
    },
    {
      '@type': 'WebSite',
      name: siteName,
      url: new URL(`/${lang}/`, Astro.site).href,
      description: desc,
      inLanguage: htmlLang,
    },
    {
      '@type': 'WebPage',
      name: fullTitle,
      url: canonical,
      description: desc,
      inLanguage: htmlLang,
      isPartOf: new URL(`/${lang}/`, Astro.site).href,
    },
    ...(extraSchema ?? []),
  ],
};
---

<!doctype html>
<html lang={htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      // 在首帧前确定主题，避免深→浅闪烁（FOUC）。
      (() => {
        try {
          const stored = localStorage.getItem('theme');
          const theme =
            stored === 'light' || stored === 'dark'
              ? stored
              : matchMedia('(prefers-color-scheme: light)').matches
                ? 'light'
                : 'dark';
          document.documentElement.dataset.theme = theme;
        } catch {
          document.documentElement.dataset.theme = 'dark';
        }
      })();
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    </noscript>
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    <meta name="robots" content={index ? 'index, follow, max-image-preview:large' : 'noindex, nofollow'} />
    <link rel="canonical" href={canonical} />
    {Object.entries(altPaths).map(([l, href]) => (
      <link rel="alternate" hreflang={htmlLangMap[l as Lang] ?? l} href={href} />
    ))}
    <link rel="alternate" hreflang="x-default" href={altPaths[defaultLang]} />
    <link rel="alternate" type="application/rss+xml" title={`${siteName} — daily cases`} href={new URL('/rss.xml', Astro.site).href} />
    <meta name="theme-color" content="#08090c" id="theme-color-meta" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:locale" content={htmlLang} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={desc} />
    <meta name="twitter:image" content={ogImage} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(schema).replaceAll('<', '\\u003c')} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    <link rel="manifest" href="/site.webmanifest" />
  </head>
  <body>
    <a href="#main" class="skip-link">{t('a11y.skip')}</a>
    <Header lang={lang} path={path} />
    <main id="main" data-pagefind-body>
      <slot />
      {cluster && index && <Cluster lang={lang} path={path} />}
    </main>
    <Footer lang={lang} />
  </body>
</html>
