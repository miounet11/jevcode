---
import { languages, useTranslations, defaultLang, htmlLangMap, type Lang } from '../i18n/ui';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

export interface Props {
  lang: Lang;
  title: string;
  description?: string;
  /** 用于 hreflang 与 canonical */
  path: string;
  /** 是否输出 docs 双栏布局（由页面自行放置内容） */
  wide?: boolean;
}

const { lang, title, description, path, wide = false } = Astro.props;
const t = useTranslations(lang);
const siteName = t('site.name');
const fullTitle = title === siteName ? `${siteName} — ${t('site.tagline')}` : `${title} | ${siteName}`;
const desc = description ?? t('site.description');

const canonical = new URL(path, Astro.site).href;
const altPaths: Record<string, string> = {};
for (const l of Object.keys(languages) as Lang[]) {
  // 去掉已有的语言前缀（任意受支持语言），再拼目标语言
  altPaths[l] = new URL(`/${l}${path.replace(/^\/[a-z]{2}(?=\/|$)/, '')}`, Astro.site).href;
}

const htmlLang = htmlLangMap[lang] ?? lang;
const ogImage = new URL('/img/og.png', Astro.site).href;
---

<!doctype html>
<html lang={htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    <link rel="canonical" href={canonical} />
    {Object.entries(altPaths).map(([l, href]) => (
      <link rel="alternate" hreflang={htmlLangMap[l as Lang] ?? l} href={href} />
    ))}
    <link rel="alternate" hreflang="x-default" href={altPaths[defaultLang]} />
    <meta name="theme-color" content="#08090c" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    <link rel="manifest" href="/site.webmanifest" />
  </head>
  <body>
    <a href="#main" class="skip-link">{t('a11y.skip')}</a>
    <Header lang={lang} path={path} />
    <main id="main" class={wide ? '' : ''}>
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>
