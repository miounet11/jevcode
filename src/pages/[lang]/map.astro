---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Cluster from '../../components/Cluster.astro';
import { languages, pick, type Lang } from '../../i18n/ui';
import { clusterGroups, clusterText, pageHref } from '../../data/cluster';
import * as mapCopy from '../../i18n/pages/map';

export const prerender = true;

export function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const path = `/${lang}/map/`;
const title = pick(lang, mapCopy.title);
const description = pick(lang, mapCopy.description);

const guideHubs = [
  { href: '/gpus/', name: pick(lang, { zh: '显卡配置', en: 'GPUs', ja: 'GPU構成', ko: 'GPU 구성', de: 'GPUs', fr: 'GPUs', es: 'GPUs', pt: 'GPUs' }) },
  { href: '/industries/', name: pick(lang, { zh: '行业案例', en: 'Industries', ja: '業界事例', ko: '산업 사례', de: 'Branchen', fr: 'Secteurs', es: 'Industrias', pt: 'Indústrias' }) },
  { href: '/recipes/', name: pick(lang, { zh: '源码库', en: 'Code', ja: 'コード集', ko: '코드 모음', de: 'Code', fr: 'Code', es: 'Código', pt: 'Código' }) },
  { href: '/configs/', name: pick(lang, { zh: '场景配置', en: 'Configs', ja: '設定集', ko: '구성 가이드', de: 'Konfigs', fr: 'Configs', es: 'Configs', pt: 'Configs' }) },
  { href: '/vibecoding/', name: pick(lang, { zh: 'Vibe编程', en: 'Vibe Coding', ja: 'Vibe Coding', ko: 'Vibe 코딩', de: 'Vibe Coding', fr: 'Vibe Coding', es: 'Vibe Coding', pt: 'Vibe Coding' }) },
  { href: '/workbench/', name: pick(lang, { zh: '交互工作台', en: 'Workbench', ja: 'ワークベンチ', ko: '워크벤치', de: 'Workbench', fr: 'Atelier', es: 'Taller', pt: 'Bancada' }) },
];

const list = [
  ...guideHubs.map((item) => ({
    name: item.name,
    url: new URL(pageHref(lang, item.href), Astro.site).href,
  })),
  ...clusterGroups.flatMap((group) =>
    group.items
      .filter((item) => item.href !== '/map/')
      .map((item) => ({
        name: clusterText(lang, item.title),
        url: new URL(pageHref(lang, item.href), Astro.site).href,
      })),
  ),
];
const itemList = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: title,
  itemListElement: list.map((item, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: item.name,
    url: item.url,
  })),
};
---

<BaseLayout lang={lang} title={title} description={description} path={path} cluster={false}>
  <section class="section">
    <div class="wrap directory-page">
      <p class="eyebrow"><span class="eyebrow__dot"></span>{title}</p>
      <h1>{title}</h1>
      <p class="directory-page__lead">{description}</p>
      <p class="directory-page__lead" set:html={pick(lang, mapCopy.lead).replaceAll('{lang}', lang)} />
      <ul class="directory-page__hubs">
        {guideHubs.map((item) => (
          <li><a href={pageHref(lang, item.href)}>{item.name}</a></li>
        ))}
      </ul>
      <Cluster lang={lang} path={path} variant="map" />
    </div>
  </section>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(itemList).replaceAll('<', '\\u003c')} />
</BaseLayout>

<style>
  .directory-page { max-width: 860px; }
  .directory-page h1 { font-size: clamp(34px, 5vw, 52px); letter-spacing: -0.04em; margin: 12px 0; }
  .directory-page__lead { color: var(--fg-muted); max-width: 66ch; }
  .directory-page__lead a { color: var(--accent-strong); }
  .directory-page__hubs {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 18px;
    margin: 18px 0 8px;
    padding: 0;
    list-style: none;
  }
  .directory-page__hubs a { color: var(--accent-strong); font-weight: 650; }
</style>
