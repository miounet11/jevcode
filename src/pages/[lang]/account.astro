---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { languages, pick, type Lang } from '../../i18n/ui';
import * as accountCopy from '../../i18n/pages/account';

export const prerender = true;

export function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const path = `/${lang}/account/`;

const copy = {
  title: pick(lang, accountCopy.title),
  lead: pick(lang, accountCopy.lead),
  loading: pick(lang, accountCopy.loading),
  notSignedIn: pick(lang, accountCopy.notSignedIn),
  signIn: pick(lang, accountCopy.signIn),
  remaining: pick(lang, accountCopy.remaining),
  perDay: pick(lang, accountCopy.perDay),
  email: pick(lang, accountCopy.email),
  plan: pick(lang, accountCopy.plan),
  keys: pick(lang, accountCopy.keys),
  noKeys: pick(lang, accountCopy.noKeys),
  issue: pick(lang, accountCopy.issue),
  issuing: pick(lang, accountCopy.issuing),
  newKeyWarn: pick(lang, accountCopy.newKeyWarn),
  prefix: pick(lang, accountCopy.prefix),
  label: pick(lang, accountCopy.label),
  created: pick(lang, accountCopy.created),
  revoke: pick(lang, accountCopy.revoke),
  revoked: pick(lang, accountCopy.revoked),
  active: pick(lang, accountCopy.active),
  logout: pick(lang, accountCopy.logout),
  confirmRevoke: pick(lang, accountCopy.confirmRevoke),
  revokeNote: pick(lang, accountCopy.revokeNote),
  ledger: pick(lang, accountCopy.ledger),
  ledNone: pick(lang, accountCopy.ledNone),
  ledTime: pick(lang, accountCopy.ledTime),
  ledKind: pick(lang, accountCopy.ledKind),
  ledAmount: pick(lang, accountCopy.ledAmount),
  kindSignup: pick(lang, accountCopy.kindSignup),
  kindJudge: pick(lang, accountCopy.kindJudge),
  kindTopup: pick(lang, accountCopy.kindTopup),
  spent: pick(lang, accountCopy.spent),
  apiDocs: pick(lang, accountCopy.apiDocs),
  copyKey: pick(lang, accountCopy.copyKey),
  copied: pick(lang, accountCopy.copied),
};
---

<BaseLayout lang={lang} title={copy.title} description={copy.lead} path={path} index={false} cluster={false}>
  <section class="section">
    <div class="wrap acct">
      <p class="eyebrow"><span class="eyebrow__dot"></span>{copy.title}</p>
      <h1>{copy.title}</h1>
      <p class="acct__lead">{copy.lead}</p>

      <p class="acct__msg" id="msg" role="status" aria-live="polite">{copy.loading}</p>

      <div id="body" hidden>
        <dl class="acct__facts">
          <div><dt>{copy.email}</dt><dd id="f-email">—</dd></div>
          <div><dt>{copy.plan}</dt><dd id="f-plan">—</dd></div>
          <div>
            <dt>{copy.remaining}</dt>
            <dd><b id="f-remaining">—</b> <span id="f-left"></span></dd>
          </div>
          <div>
            <dt>{copy.spent}</dt>
            <dd><b id="f-spent">—</b></dd>
          </div>
        </dl>

        <div class="acct__keys">
          <h2>{copy.keys}</h2>
          <p class="acct__none" id="keys-none">{copy.noKeys}</p>
          <table class="acct__table" id="keys-table" hidden>
            <thead>
              <tr>
                <th>{copy.prefix}</th><th>{copy.label}</th>
                <th>{copy.created}</th><th></th>
              </tr>
            </thead>
            <tbody id="keys-body"></tbody>
          </table>
          <p class="acct__hint">{copy.revokeNote}</p>

          <div class="acct__actions">
            <button class="btn btn--primary" type="button" id="issue">{copy.issue}</button>
            <a class="btn btn--ghost" href={`/${lang}/api/`}>{copy.apiDocs}</a>
            <button class="btn btn--ghost" type="button" id="logout">{copy.logout}</button>
          </div>
          <p class="acct__newkey" id="newkey" hidden></p>
        </div>

        <div class="acct__keys">
          <h2>{copy.ledger}</h2>
          <p class="acct__none" id="led-none">{copy.ledNone}</p>
          <table class="acct__table" id="led-table" hidden>
            <thead>
              <tr><th>{copy.ledTime}</th><th>{copy.ledKind}</th><th>{copy.ledAmount}</th></tr>
            </thead>
            <tbody id="led-body"></tbody>
          </table>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script define:vars={{ copy, signInPath: `/${lang}/login/`, locale: lang === 'zh' ? 'zh-CN' : 'en-US' }}>
  const msg = document.getElementById('msg');
  const body = document.getElementById('body');

  const esc = (s) => String(s == null ? '' : s);

  function showSignedOut() {
    msg.textContent = copy.notSignedIn;
    const a = document.createElement('a');
    a.href = signInPath;
    a.textContent = copy.signIn;
    msg.append(' ', a);
  }

  function renderKeys(keys) {
    const table = document.getElementById('keys-table');
    const none = document.getElementById('keys-none');
    const tb = document.getElementById('keys-body');
    tb.replaceChildren();

    if (!keys || keys.length === 0) {
      none.hidden = false; table.hidden = true; return;
    }
    none.hidden = true; table.hidden = false;

    for (const k of keys) {
      const tr = document.createElement('tr');

      const tdPrefix = document.createElement('td');
      const code = document.createElement('code');
      code.textContent = esc(k.prefix) + '…';
      tdPrefix.append(code);

      const tdLabel = document.createElement('td');
      tdLabel.textContent = k.label ? esc(k.label) : '—';

      const tdCreated = document.createElement('td');
      tdCreated.textContent = k.createdAt ? new Date(k.createdAt).toISOString().slice(0, 10) : '—';

      const tdAct = document.createElement('td');
      if (k.revokedAt) {
        const span = document.createElement('span');
        span.className = 'acct__revoked';
        span.textContent = copy.revoked;
        tdAct.append(span);
      } else {
        const b = document.createElement('button');
        b.type = 'button';
        b.className = 'btn btn--ghost acct__revoke';
        b.textContent = copy.revoke;
        // 两段式确认：第一次点变成红色确认按钮（就地，不弹窗），5 秒不点自动还原。
        // 原生 window.confirm 样式突兀且不可定制，就地确认让后果文字就在按钮旁边。
        let armed = false;
        let disarmTimer;
        const disarm = () => {
          armed = false;
          b.textContent = copy.revoke;
          b.classList.remove('acct__revoke--armed');
        };
        b.addEventListener('click', async () => {
          if (!armed) {
            armed = true;
            b.textContent = copy.confirmRevoke;
            b.classList.add('acct__revoke--armed');
            clearTimeout(disarmTimer);
            disarmTimer = setTimeout(disarm, 5000);
            return;
          }
          clearTimeout(disarmTimer);
          b.disabled = true;
          try {
            const r = await fetch('/api/keys/revoke', {
              method: 'POST',
              headers: { 'content-type': 'application/json' },
              credentials: 'same-origin',
              body: JSON.stringify({ id: k.id }),
            });
            if (r.ok) { await load(); return; }
            b.disabled = false;
            disarm();
          } catch { b.disabled = false; disarm(); }
        });
        tdAct.append(b);
      }

      tr.append(tdPrefix, tdLabel, tdCreated, tdAct);
      tb.append(tr);
    }
  }

  async function load() {
    try {
      const res = await fetch('/api/auth/me', { credentials: 'same-origin' });
      // 未登录现在返回 200 + user:null（guest 站点不再用 401 表达未登录），
      // 401 分支只兼容尚未重发布时的旧服务端。
      if (res.status === 401) { showSignedOut(); return; }
      const data = await res.json();
      if (!data.user) { showSignedOut(); return; }

      msg.textContent = '';
      body.hidden = false;
      document.getElementById('f-email').textContent = esc(data.user.email);
      document.getElementById('f-plan').textContent = esc(data.user.plan);
      const bal = data.credit || {};
      document.getElementById('f-remaining').textContent =
        bal.usd == null ? '—' : `$${esc(bal.usd)}`;
      const tokensLeft = bal.inputTokensLeft != null ? bal.inputTokensLeft : bal.judgmentsLeft;
      document.getElementById('f-left').textContent =
        tokensLeft == null ? '' : `${Number(tokensLeft).toLocaleString(locale)} ${copy.perDay}`;
      document.getElementById('f-spent').textContent =
        data.spentUsd != null ? `$${esc(data.spentUsd)}` : '—';
      renderKeys(data.keys);
      loadLedger();
    } catch {
      showSignedOut();
    }
  }

  /** 消费明细：正数入账、负数消费 */
  function renderLedger(entries) {
    const table = document.getElementById('led-table');
    const none = document.getElementById('led-none');
    const tb = document.getElementById('led-body');
    tb.replaceChildren();

    if (!entries || entries.length === 0) {
      none.hidden = false; table.hidden = true; return;
    }
    none.hidden = true; table.hidden = false;

    const kindLabel = (k) =>
      ({ signup_credit: copy.kindSignup, judge: copy.kindJudge, topup: copy.kindTopup }[k] || k);

    for (const e of entries) {
      const tr = document.createElement('tr');

      const tdTime = document.createElement('td');
      // 用本地时区展示：toISOString() 会给 UTC，中国用户看到的时间会偏 8 小时
      tdTime.textContent = e.ts
        ? new Date(e.ts).toLocaleString(locale, {
            year: 'numeric', month: '2-digit', day: '2-digit',
            hour: '2-digit', minute: '2-digit',
          })
        : '—';

      const tdKind = document.createElement('td');
      tdKind.textContent = kindLabel(e.kind);

      const tdAmt = document.createElement('td');
      const micro = Number(e.microUsd != null ? e.microUsd : (Number(e.cents) * 10000));
      const usd = e.usd != null ? e.usd : (Math.abs(micro) / 1_000_000).toFixed(6);
      tdAmt.textContent = (micro < 0 ? '−' : '+') + '$' + usd;
      if (micro > 0) tdAmt.className = 'acct__credit-in';

      tr.append(tdTime, tdKind, tdAmt);
      tb.append(tr);
    }
  }

  /** 明细要单独取一次（/me 不带流水） */
  async function loadLedger() {
    try {
      const r = await fetch('/api/auth/ledger', { credentials: 'same-origin' });
      if (!r.ok) return;
      const d = await r.json();
      renderLedger(d.entries);
    } catch { /* 明细拿不到不影响主要信息 */ }
  }

  document.getElementById('issue').addEventListener('click', async (e) => {
    const btn = e.currentTarget;
    btn.disabled = true;
    const label = btn.textContent;
    btn.textContent = copy.issuing;
    try {
      const r = await fetch('/api/keys', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        credentials: 'same-origin',
        body: JSON.stringify({ label: 'web' }),
      });
      const d = await r.json().catch(() => ({}));
      const box = document.getElementById('newkey');
      if (r.ok && d.key) {
        box.hidden = false;
        box.replaceChildren();
        const warn = document.createElement('strong');
        warn.textContent = copy.newKeyWarn;
        const code = document.createElement('code');
        code.textContent = d.key;
        // 一键复制：新密钥明文只出现一次，别让用户手动划选
        const copyBtn = document.createElement('button');
        copyBtn.type = 'button';
        copyBtn.className = 'btn btn--ghost acct__copy';
        copyBtn.textContent = copy.copyKey;
        copyBtn.addEventListener('click', async () => {
          try {
            await navigator.clipboard.writeText(d.key);
            copyBtn.textContent = copy.copied;
            copyBtn.disabled = true;
          } catch {
            /* 复制失败就保持原样，用户仍可手动选择 */
          }
        });
        box.append(warn, code, copyBtn);
        await load();
      }
    } finally {
      btn.disabled = false;
      btn.textContent = label;
    }
  });

  document.getElementById('logout').addEventListener('click', async () => {
    await fetch('/api/auth/logout', { method: 'POST', credentials: 'same-origin' });
    window.location.assign(signInPath);
  });

  load();
</script>

<style>
  .acct { max-width: 720px; }
  .acct h1 { font-size: clamp(30px, 4vw, 42px); letter-spacing: -0.04em; margin: 12px 0; }
  .acct__lead { color: var(--fg-muted); }
  .acct__msg { color: var(--fg-muted); min-height: 1.4em; }
  .acct__facts { display: grid; gap: 14px; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); margin: 18px 0 28px; }
  .acct__facts dt { color: var(--fg-dim); font-size: 13px; }
  .acct__facts dd { margin: 4px 0 0; }
  .acct__facts span { font-size: 13px; color: var(--fg-dim); }
  .acct__keys { border-top: 1px solid var(--border); padding-top: 20px; }
  .acct__keys h2 { font-size: 18px; }
  .acct__table { width: 100%; border-collapse: collapse; font-size: 14px; }
  .acct__table th, .acct__table td { text-align: left; padding: 9px 8px; border-bottom: 1px solid var(--border); }
  .acct__table th { color: var(--fg-dim); font-weight: 500; }
  .acct__none { color: var(--fg-dim); font-size: 14px; }
  .acct__actions { display: flex; gap: 10px; margin-top: 16px; flex-wrap: wrap; }
  .acct__newkey { margin-top: 14px; display: grid; gap: 8px; justify-items: start; font-size: 14px; padding: 14px; border: 1px solid var(--border-strong); border-radius: 12px; background: var(--bg-elev); }
  .acct__newkey code { word-break: break-all; padding: 8px 10px; background: var(--bg-code); border-radius: 8px; display: block; }
  .acct__copy { min-height: 36px; padding: 6px 14px; font-size: 14px; }
  .acct__revoked { color: var(--fg-dim); font-size: 13px; }
  .acct__hint { margin: 8px 0 0; font-size: 12.5px; color: var(--fg-dim); }
  .acct__revoke--armed { border-color: var(--rose); color: var(--rose); }
  .acct__revoke--armed:hover { border-color: var(--rose); background: var(--bg-elev-2); box-shadow: none; }
</style>
