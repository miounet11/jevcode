---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Sidebar from '../../components/Sidebar.astro';
import { languages, useTranslations, pick, type Lang } from '../../i18n/ui';
import ownCards from '../../../data/builds/cards.json';
import * as buildsCopy from '../../i18n/pages/builds';

// 只展示本站用 Jev 判定出的卡片。没有卡片时照常渲染空页，
// 不再退回竞品镜像——镜像只作候选 id 来源，不是本站产出。
const cards = ownCards.cards ?? [];
const snapshot = {
  source: 'syndication + Jev judgment',
  updated: ownCards.updated ?? '',
  analysed: cards.length,
  authors: new Set(cards.map((card) => card.sn)).size,
  total: cards.length,
  categories: Object.entries(cards.reduce<Record<string, number>>((acc, card) => {
    acc[card.cat] = (acc[card.cat] ?? 0) + 1;
    return acc;
  }, {})).sort((a, b) => b[1] - a[1]),
  usecases: Object.entries(cards.reduce<Record<string, number>>((acc, card) => {
    acc[card.u] = (acc[card.u] ?? 0) + 1;
    return acc;
  }, {})).sort((a, b) => b[1] - a[1]),
  cards,
};

export function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: Lang };
const path = `/${lang}/builds/`;
const t = useTranslations(lang);
const fmt = (n: number) => new Intl.NumberFormat('en').format(n);

const copy = {
  title: pick(lang, buildsCopy.title),
  lead: pick(lang, buildsCopy.lead),
  collected: pick(lang, buildsCopy.collected),
  analysed: pick(lang, buildsCopy.analysed),
  authors: pick(lang, buildsCopy.authors),
  updated: pick(lang, buildsCopy.updated).replace('{date}', snapshot.updated),
  source: pick(lang, buildsCopy.source),
  category: pick(lang, buildsCopy.category),
  usecase: pick(lang, buildsCopy.usecase),
  all: pick(lang, buildsCopy.all),
  search: pick(lang, buildsCopy.search),
  shownTpl: pick(lang, buildsCopy.shownTpl),
  empty: pick(lang, buildsCopy.empty),
  post: pick(lang, buildsCopy.post),
  link: pick(lang, buildsCopy.link),
};

const categories = snapshot.categories.filter((entry) => entry[0]);
const usecases = snapshot.usecases.filter((entry) => entry[0]);
---

<BaseLayout lang={lang} title={copy.title} description={copy.lead} path={path}>
  <div class="wrap docs-shell">
    <Sidebar lang={lang} />
    <main class="doc">
      <p class="doc__breadcrumb">
        <a href={`/${lang}/`}>{t('site.name')}</a> / {t('nav.builds')}
      </p>
      <h1 class="doc__title">{copy.title}</h1>
      <p class="doc__desc">{copy.lead}</p>

      <div class="stats__grid stats__grid--3">
        <div class="stat">
          <div class="stat__num">{fmt(snapshot.total)}</div>
          <div class="stat__label">{copy.collected}</div>
        </div>
        <div class="stat">
          <div class="stat__num">{fmt(snapshot.analysed)}</div>
          <div class="stat__label">{copy.analysed}</div>
        </div>
        <div class="stat">
          <div class="stat__num">{fmt(snapshot.authors)}</div>
          <div class="stat__label">{copy.authors}</div>
        </div>
      </div>

      <div class="eco-filter">
        <div class="eco-filter__row">
          <label class="eco-filter__label" for="build-cat">{copy.category}</label>
          <select id="build-cat" data-cat>
            <option value="">{copy.all}</option>
            {categories.map(([name, count]) => <option value={name}>{name} ({count})</option>)}
          </select>
          <label class="eco-filter__label" for="build-use">{copy.usecase}</label>
          <select id="build-use" data-use>
            <option value="">{copy.all}</option>
            {usecases.map(([name, count]) => <option value={name}>{name} ({count})</option>)}
          </select>
          <input data-search type="search" placeholder={copy.search} />
          <span data-count data-tpl={copy.shownTpl}></span>
        </div>
      </div>

      <ul class="build-list" data-list></ul>
      <p data-empty hidden>{copy.empty}</p>
      <div class="build-pager" data-pager></div>
      <p class="eco__snapshot">
        {copy.updated}
        <a href={snapshot.source}>{copy.source}</a>
      </p>
    </main>
  </div>
</BaseLayout>

<script define:vars={{ labels: { post: copy.post, link: copy.link } }}>
  const PAGE = 40;
  const list = document.querySelector('[data-list]');
  const pager = document.querySelector('[data-pager]');
  const countEl = document.querySelector('[data-count]');
  const emptyEl = document.querySelector('[data-empty]');
  const catEl = document.querySelector('[data-cat]');
  const useEl = document.querySelector('[data-use]');
  const searchEl = document.querySelector('[data-search]');
  let cards = [];
  let page = 0;

  function matched() {
    const cat = catEl.value;
    const use = useEl.value;
    const q = searchEl.value.trim().toLowerCase();
    return cards.filter((card) => {
      if (cat && card.cat !== cat) return false;
      if (use && card.u !== use) return false;
      if (!q) return true;
      return `${card.t} ${card.x} ${card.name} ${card.sn}`.toLowerCase().includes(q);
    });
  }

  function render() {
    const rows = matched();
    const pages = Math.max(1, Math.ceil(rows.length / PAGE));
    if (page >= pages) page = pages - 1;
    const slice = rows.slice(page * PAGE, page * PAGE + PAGE);
    list.replaceChildren();
    for (const card of slice) {
      const li = document.createElement('li');
      li.className = 'build-card';
      const title = document.createElement('a');
      title.href = card.url;
      title.textContent = card.t;
      title.rel = 'noopener noreferrer';
      title.target = '_blank';
      const meta = document.createElement('p');
      meta.className = 'build-card__meta';
      meta.textContent = [card.d, card.cat, card.u, card.name ? `${card.name} (@${card.sn})` : `@${card.sn}`]
        .filter(Boolean)
        .join(' · ');
      const excerpt = document.createElement('p');
      excerpt.textContent = card.x;
      li.append(title, meta, excerpt);
      if (card.link) {
        const extra = document.createElement('a');
        extra.href = card.link;
        extra.textContent = labels.link;
        extra.rel = 'noopener noreferrer';
        extra.target = '_blank';
        li.append(extra);
      }
      list.append(li);
    }
    countEl.textContent = countEl.dataset.tpl.replace('{n}', String(rows.length));
    emptyEl.hidden = rows.length !== 0;
    pager.replaceChildren();
    if (pages > 1) {
      const prev = document.createElement('button');
      prev.type = 'button';
      prev.textContent = '←';
      prev.disabled = page === 0;
      prev.addEventListener('click', () => { page -= 1; render(); });
      const label = document.createElement('span');
      label.textContent = `${page + 1} / ${pages}`;
      const next = document.createElement('button');
      next.type = 'button';
      next.textContent = '→';
      next.disabled = page + 1 >= pages;
      next.addEventListener('click', () => { page += 1; render(); });
      pager.append(prev, label, next);
    }
  }

  for (const el of [catEl, useEl]) el.addEventListener('change', () => { page = 0; render(); });
  searchEl.addEventListener('input', () => { page = 0; render(); });

  // 不能在这里用顶层 await：define:vars 会让 Astro 把脚本内联成传统 <script>
  // （没有 type="module"），顶层 await 直接是语法错误，整段脚本不执行，
  // 列表就永远空着。改成 promise 链。
  fetch('/data/jev-cards.json')
    .then((r) => r.json())
    .then((d) => { cards = d.cards ?? []; render(); })
    .catch(() => { emptyEl.hidden = false; });
</script>

<style>
  .build-list {
    list-style: none;
    margin: 16px 0 0;
    padding: 0;
    display: grid;
    gap: 10px;
  }
  /* 卡片、标题、摘要、翻页控件全部由 render() 用 createElement 生成，不带
     Astro 的 scoped 属性；写成普通后代/类选择器会被编译成 `...[cid]` 而落空。 */
  .build-list :global(.build-card) {
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--bg-elev);
    padding: 12px 14px;
  }
  .build-list :global(.build-card > a) {
    font-weight: 650;
  }
  .build-list :global(.build-card__meta),
  .build-list :global(.build-card p) {
    margin: 6px 0 0;
    color: var(--fg-muted);
    font-size: 13px;
  }
  .build-pager :global(button) {
    min-width: 44px;
    height: 44px;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--bg);
    color: var(--fg);
    font: inherit;
    cursor: pointer;
  }
  .build-pager :global(button:disabled) {
    color: var(--fg-dim);
    cursor: default;
  }
  .build-pager :global(span) {
    color: var(--fg-muted);
    font-size: 13px;
    font-variant-numeric: tabular-nums;
  }
  .build-pager {
    display: flex;
    gap: 8px;
    align-items: center;
    margin-top: 12px;
  }
  .eco-filter select,
  .eco-filter input {
    border: 1px solid var(--border);
    background: var(--bg);
    color: var(--fg);
    border-radius: 6px;
    padding: 6px 8px;
  }
</style>
