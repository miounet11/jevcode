---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { languages, pick, type Lang } from '../../i18n/ui';
import * as apiCopy from '../../i18n/pages/api';
import {
  INPUT_USD_PER_MILLION, SIGNUP_CREDIT_CENTS, SIGNUP_CREDIT_MICROUSD, SIGNUP_INPUT_TOKENS, centsToUsd,
} from '../../../server/plans.mjs';

export const prerender = true;

export function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const path = `/${lang}/api/`;

const copy = {
  title: 'API',
  lead: pick(lang, apiCopy.lead).replace('{credit}', `$${centsToUsd(SIGNUP_CREDIT_CENTS)}`).replace('{rate}', `$${INPUT_USD_PER_MILLION}`),
  getKeyLead: pick(lang, apiCopy.getKeyLead),
  getKey: pick(lang, apiCopy.getKey),
  authTitle: pick(lang, apiCopy.authTitle),
  authLead: pick(lang, apiCopy.authLead),
  endpointsTitle: pick(lang, apiCopy.endpointsTitle),
  epJudge: pick(lang, apiCopy.epJudge),
  epMe: pick(lang, apiCopy.epMe),
  epUsage: pick(lang, apiCopy.epUsage),
  reqTitle: pick(lang, apiCopy.reqTitle),
  reqStateDesc: pick(lang, apiCopy.reqStateDesc),
  reqQuestionsDesc: pick(lang, apiCopy.reqQuestionsDesc),
  typesTitle: pick(lang, apiCopy.typesTitle),
  typeNoul: pick(lang, apiCopy.typeNoul),
  typeConf: pick(lang, apiCopy.typeConf),
  typeChoice: pick(lang, apiCopy.typeChoice),
  respTitle: pick(lang, apiCopy.respTitle),
  respCredit: pick(lang, apiCopy.respCredit),
  creditTitle: pick(lang, apiCopy.creditTitle),
  creditFields: pick(lang, apiCopy.creditFields),
  errTitle: pick(lang, apiCopy.errTitle),
  errTh: pick(lang, apiCopy.errTh),
  errCodes: pick(lang, apiCopy.errCodes),
  exampleTitle: pick(lang, apiCopy.exampleTitle),
  ctaTry: pick(lang, apiCopy.ctaTry),
  ctaPricing: pick(lang, apiCopy.ctaPricing),
};

const curlExample = `curl https://api.jevcode.ai/v1/judge \\
  -H "Authorization: Bearer jev_..." \\
  -H "Content-Type: application/json" \\
  -d '{
    "state": "The build failed on the second job, then passed after a retry.",
    "questions": {
      "relevance":   { "type": "noul",       "instructions": "Is this about CI?" },
      "confidence":  { "type": "confidence", "instructions": "How sure are you?" },
      "severity":    { "type": "choice",     "instructions": "Pick one.",
                       "options": ["low", "medium", "high"] }
    }
  }'`;

const okExample = `{
  "id": "k3f9a1c2b4d5",
  "model": "clavue-jev",
  "answers": {
    "relevance":  { "noul": 0.92 },
    "confidence": { "noul": 0.78 },
    "severity":   { "choice": "medium" }
  },
  "credit": { "cents": ${SIGNUP_CREDIT_CENTS}, "usd": "${centsToUsd(SIGNUP_CREDIT_CENTS)}", "microUsd": ${SIGNUP_CREDIT_MICROUSD}, "inputTokensLeft": ${SIGNUP_INPUT_TOKENS} }
}`;

const creditExample = `{
  "cents": ${SIGNUP_CREDIT_CENTS},
  "usd": "${centsToUsd(SIGNUP_CREDIT_CENTS)}",
  "microUsd": ${SIGNUP_CREDIT_MICROUSD},
  "inputTokensLeft": ${SIGNUP_INPUT_TOKENS}
}`;
---

<BaseLayout lang={lang} title={copy.title} description={copy.lead} path={path}>
  <section class="section">
    <div class="wrap api">
      <p class="eyebrow"><span class="eyebrow__dot"></span>{copy.title}</p>
      <h1>{copy.title}</h1>
      <p class="api__lead">{copy.lead}</p>

      <div class="api__key">
        <p>{copy.getKeyLead}</p>
        <a class="btn btn--primary" href={`/${lang}/account/`}>{copy.getKey}</a>
      </div>

      <h2>{copy.authTitle}</h2>
      <p class="api__lead">{copy.authLead}</p>
      <pre class="api__code"><code>{`Authorization: Bearer jev_...`}</code></pre>

      <h2>{copy.endpointsTitle}</h2>
      <table class="api__table">
        <tbody>
          <tr><td><code>POST /v1/judge</code></td><td>{copy.epJudge}</td></tr>
          <tr><td><code>GET /v1/me</code></td><td>{copy.epMe}</td></tr>
          <tr><td><code>GET /v1/usage</code></td><td>{copy.epUsage}</td></tr>
        </tbody>
      </table>

      <h2>{copy.reqTitle}</h2>
      <table class="api__table">
        <tbody>
          <tr><td><code>state</code></td><td>{copy.reqStateDesc}</td></tr>
          <tr><td><code>questions</code></td><td>{copy.reqQuestionsDesc}</td></tr>
        </tbody>
      </table>

      <h3>{copy.typesTitle}</h3>
      <table class="api__table">
        <tbody>
          <tr><td><code>noul</code></td><td>{copy.typeNoul}</td></tr>
          <tr><td><code>confidence</code></td><td>{copy.typeConf}</td></tr>
          <tr><td><code>choice</code></td><td>{copy.typeChoice}</td></tr>
        </tbody>
      </table>

      <h2>{copy.respTitle}</h2>
      <p class="api__lead">{copy.respCredit}</p>
      <pre class="api__code"><code>{okExample}</code></pre>

      <h3>{copy.creditTitle}</h3>
      <pre class="api__code"><code>{creditExample}</code></pre>
      <table class="api__table">
        <tbody>
          {copy.creditFields.map(([field, desc]) => (
            <tr><td><code>{field}</code></td><td>{desc}</td></tr>
          ))}
        </tbody>
      </table>

      <h2>{copy.errTitle}</h2>
      <table class="api__table">
        <thead>
          <tr><th>{copy.errTh}</th><th>error</th><th></th></tr>
        </thead>
        <tbody>
          {copy.errCodes.map(([status, code, desc]) => (
            <tr>
              <td><code>{status}</code></td>
              <td><code>{code}</code></td>
              <td>{desc}</td>
            </tr>
          ))}
        </tbody>
      </table>

      <h2>{copy.exampleTitle}</h2>
      <pre class="api__code"><code>{curlExample}</code></pre>

      <div class="api__cta">
        <a class="btn btn--ghost" href={`/${lang}/try/`}>{copy.ctaTry}</a>
        <a class="btn btn--ghost" href={`/${lang}/pricing/`}>{copy.ctaPricing}</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .api { max-width: 820px; }
  .api h1 { font-size: clamp(34px, 5vw, 52px); letter-spacing: -0.04em; margin: 12px 0; }
  .api h2 { font-size: 22px; margin: 34px 0 10px; }
  .api h3 { font-size: 17px; margin: 22px 0 8px; }
  .api__lead { color: var(--fg-muted); max-width: 64ch; }
  .api__key {
    border: 1px solid var(--border-strong);
    border-radius: 14px;
    padding: 18px 20px;
    background: var(--bg-elev);
    display: grid;
    gap: 12px;
    justify-items: start;
    margin: 22px 0;
  }
  .api__key p { margin: 0; color: var(--fg-muted); }
  .api__table { width: 100%; border-collapse: collapse; font-size: 14px; margin: 8px 0 4px; }
  .api__table th, .api__table td { text-align: left; padding: 9px 8px; border-bottom: 1px solid var(--border); vertical-align: top; }
  .api__table th { color: var(--fg-dim); font-weight: 500; }
  .api__table td:first-child { white-space: nowrap; }
  .api__code {
    background: var(--bg-elev);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 14px 16px;
    overflow-x: auto;
    font-size: 13px;
    line-height: 1.55;
    margin: 8px 0 4px;
  }
  .api__code code { background: none; padding: 0; }
  .api__cta { display: flex; gap: 10px; flex-wrap: wrap; margin-top: 28px; }
</style>
