---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { languages, pick, type Lang } from '../../../i18n/ui';
import { GPU_PROFILES } from '../../../data/gpus';
import * as copy from '../../../i18n/pages/gpus';

export function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: Lang };
const path = `/${lang}/gpus/`;
const t = (bag: Parameters<typeof pick<string>>[1]) => pick(lang, bag);

const pageTitle = t(copy.title);
const pageDescription = t(copy.description);
const canonical = new URL(path, Astro.site).href;
const roadmap = GPU_PROFILES.find((g) => g.slug === 'next-gen-b300-rubin-roadmap') ?? GPU_PROFILES[0];

// 默认预选两张热门卡，面板打开即可用；slug 不存在时回退到前两张。
const cmpFirst = 'rtx-5090-32g';
const cmpSecond = 'nvidia-b200-192g';
const cmpASlug = GPU_PROFILES.some((g) => g.slug === cmpFirst) ? cmpFirst : (GPU_PROFILES[0]?.slug ?? '');
const cmpBSlug = GPU_PROFILES.some((g) => g.slug === cmpSecond)
  ? cmpSecond
  : (GPU_PROFILES.find((g) => g.slug !== cmpASlug)?.slug ?? '');

const cmpJson = JSON.stringify({
  lang,
  gpus: GPU_PROFILES.map((g) => ({
    slug: g.slug,
    name: g.name,
    arch: g.arch,
    vram: `${g.vramGb} GB ${g.vramType}`,
    vramGb: g.vramGb,
    bw: g.bandwidthGbs,
    fp8: g.fp8Tflops,
    tdp: g.tdpW,
    interconnect: g.interconnect,
    cloud: g.typicalCloudUsdHr,
    savings: g.jevBypassSavings,
    savingsPct: Number.parseInt(g.jevBypassSavings, 10) || 0,
  })),
  labels: {
    compare: t(copy.compareBtn),
    selected: t(copy.comparedBtn),
    arch: t(copy.specArch),
    vram: t(copy.specVram),
    bw: t(copy.specBandwidth),
    fp8: t(copy.specFp8),
    tdp: t(copy.specTdp),
    interconnect: t(copy.specInterconnect),
    cloud: t(copy.specCloud),
    savings: t(copy.specSavings),
    details: t(copy.viewDetails),
    workbench: t(copy.openWorkbench),
  },
}).replaceAll('<', '\\u003c').replaceAll('&', '\\u0026');

const tiers = [
  ['all', t(copy.tierAll)],
  ['consumer', t(copy.tierConsumer)],
  ['workstation', t(copy.tierWorkstation)],
  ['datacenter', t(copy.tierDatacenter)],
  ['roadmap', t(copy.tierRoadmap)],
] as const;

const vendors = ['all', 'NVIDIA', 'AMD', 'Apple', 'Future Roadmap'] as const;

const schema = [
  {
    '@type': 'CollectionPage',
    name: pageTitle,
    description: pageDescription,
    url: canonical,
    inLanguage: lang,
    mainEntity: {
      '@type': 'ItemList',
      numberOfItems: GPU_PROFILES.length,
      itemListElement: GPU_PROFILES.map((g, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        name: g.name,
        url: new URL(`/${lang}/gpus/${g.slug}/`, Astro.site).href,
      })),
    },
  },
];
---

<BaseLayout lang={lang} title={pageTitle} description={pageDescription} path={path} schema={schema}>
  <div class="wrap">
    <div class="doc gpu">
      <p class="gpu__eyebrow">{t(copy.eyebrow)}</p>
      <h1 class="doc__title">{pageTitle}</h1>
      <p class="doc__desc">{t(copy.lead)}</p>

      <figure class="gpu__hero">
        <img
          src="/img/guides/gpus-hero.webp"
          alt={t(copy.heroAlt)}
          width="1344"
          height="768"
          loading="eager"
          decoding="async"
        />
      </figure>

      <div class="gpu__bar">
        <div class="gpu__chips" role="group" aria-label={t(copy.tierAll)}>
          {tiers.map(([id, label], i) => (
            <button type="button" class:list={['gpu__chip', { 'is-on': i === 0 }]} data-tier={id}>{label}</button>
          ))}
        </div>
        <label class="gpu__vendor">
          <span>{t(copy.vendorLabel)}</span>
          <select data-vendor>
            {vendors.map((v) => (
              <option value={v}>{v === 'all' ? t(copy.tierAll) : v}</option>
            ))}
          </select>
        </label>
        <label class="gpu__search">
          <span class="gpu__sr">{t(copy.searchLabel)}</span>
          <input type="search" data-q placeholder={t(copy.searchLabel)} />
        </label>
      </div>

      <p class="gpu__empty" data-empty hidden>{t(copy.noMatch)}</p>

      <div class="gpu__table-wrap">
        <table class="gpu__table">
          <thead>
            <tr>
              <th><button type="button" data-sort="name">{t(copy.specGpu)}</button></th>
              <th><button type="button" data-sort="arch">{t(copy.specArch)}</button></th>
              <th><button type="button" data-sort="vram">{t(copy.specVram)}</button></th>
              <th><button type="button" data-sort="bw">{t(copy.specBandwidth)}</button></th>
              <th><button type="button" data-sort="fp8">{t(copy.specFp8)}</button></th>
              <th><button type="button" data-sort="tdp">{t(copy.specTdp)}</button></th>
              <th>{t(copy.specInterconnect)}</th>
              <th>{t(copy.specCloud)}</th>
              <th><button type="button" data-sort="save">{t(copy.specSavings)}</button></th>
              <th><span class="gpu__sr">{t(copy.compareBtn)}</span></th>
            </tr>
          </thead>
          <tbody>
            {GPU_PROFILES.map((g) => (
              <tr
                data-row
                data-tier={g.tier}
                data-vendor={g.vendor}
                data-name={g.name.toLowerCase()}
                data-arch={g.arch.toLowerCase()}
                data-vram={g.vramGb}
                data-bw={g.bandwidthGbs}
                data-fp8={g.fp8Tflops}
                data-tdp={g.tdpW}
                data-save={parseInt(g.jevBypassSavings, 10) || 0}
              >
                <td><a href={`/${lang}/gpus/${g.slug}/`}>{g.name}</a></td>
                <td>{g.arch}</td>
                <td>{g.vramGb} GB {g.vramType}</td>
                <td>{g.bandwidthGbs.toLocaleString('en-US')} GB/s</td>
                <td>{g.fp8Tflops.toLocaleString('en-US')}</td>
                <td>{g.tdpW} W</td>
                <td>{g.interconnect}</td>
                <td>{g.typicalCloudUsdHr}</td>
                <td>{g.jevBypassSavings}</td>
                <td>
                  <button type="button" class="gpu__cmp-btn" data-compare-slug={g.slug} aria-pressed="false">{t(copy.compareBtn)}</button>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <script type="application/json" id="gpu-cmp-data" set:html={cmpJson} />

      <section class="gpu__cmp" data-cmp-panel aria-live="polite">
        <div class="gpu__cmp-head">
          <h2>{t(copy.compareTitle)}</h2>
          <p>{t(copy.compareHint)}</p>
        </div>
        <div class="gpu__cmp-pickers">
          <label>
            <span>Slot A</span>
            <select data-cmp-a>
              {GPU_PROFILES.map((g) => (
                <option value={g.slug} selected={g.slug === cmpASlug}>{g.name}</option>
              ))}
            </select>
          </label>
          <span class="gpu__cmp-vs">vs</span>
          <label>
            <span>Slot B</span>
            <select data-cmp-b>
              {GPU_PROFILES.map((g) => (
                <option value={g.slug} selected={g.slug === cmpBSlug}>{g.name}</option>
              ))}
            </select>
          </label>
          <button type="button" class="gpu__cmp-clear" data-cmp-clear>{t(copy.compareClear)}</button>
        </div>
        <div class="gpu__cmp-body" data-cmp-output>
          <table class="gpu__cmp-table">
            <thead>
              <tr><th></th><th data-cmp-name-a></th><th data-cmp-name-b></th></tr>
            </thead>
            <tbody data-cmp-rows></tbody>
          </table>
          <p class="gpu__cmp-cleared" data-cmp-empty hidden>{t(copy.compareHint)}</p>
        </div>
      </section>

      <ul class="gpu__cards">
        {GPU_PROFILES.map((g) => (
          <li
            data-card
            data-tier={g.tier}
            data-vendor={g.vendor}
            data-name={g.name.toLowerCase()}
            data-arch={g.arch.toLowerCase()}
          >
            <p class="gpu__meta">{g.vendor} · {g.tier}</p>
            <h2><a href={`/${lang}/gpus/${g.slug}/`}>{g.name}</a></h2>
            <p>{pick(lang, g.tagline)}</p>
            <dl>
              <div><dt>{t(copy.specVram)}</dt><dd>{g.vramGb} GB</dd></div>
              <div><dt>{t(copy.specBandwidth)}</dt><dd>{g.bandwidthGbs.toLocaleString('en-US')} GB/s</dd></div>
              <div><dt>{t(copy.specFp8)}</dt><dd>{g.fp8Tflops.toLocaleString('en-US')} TFLOPS</dd></div>
              <div><dt>{t(copy.specTdp)}</dt><dd>{g.tdpW} W</dd></div>
              <div><dt>{t(copy.specSavings)}</dt><dd>{g.jevBypassSavings}</dd></div>
            </dl>
            <div class="gpu__card-actions">
              <a class="btn btn--ghost" href={`/${lang}/gpus/${g.slug}/`}>{t(copy.viewDetails)}</a>
              <button type="button" class="gpu__cmp-btn" data-compare-slug={g.slug} aria-pressed="false">{t(copy.compareBtn)}</button>
              <a class="btn btn--ghost" href={`/${lang}/workbench/?gpu=${g.slug}`}>{t(copy.openWorkbench)}</a>
            </div>
          </li>
        ))}
      </ul>

      <section class="gpu__road">
        <img
          src="/img/guides/gpus-roadmap.webp"
          alt={t(copy.roadmapAlt)}
          width="1344"
          height="768"
          loading="lazy"
          decoding="async"
        />
        <div>
          <h2>{t(copy.roadmapTitle)}</h2>
          <p>{t(copy.roadmapLead)}</p>
          <p><a href={`/${lang}/gpus/${roadmap.slug}/`}>{roadmap.name}</a></p>
        </div>
      </section>
    </div>
  </div>
</BaseLayout>

<script>
  const root = document.querySelector('.gpu');
  const q = root?.querySelector<HTMLInputElement>('[data-q]');
  const vendor = root?.querySelector<HTMLSelectElement>('[data-vendor]');
  const body = root?.querySelector('tbody');
  if (root && q && vendor && body) {
    const rows = [...root.querySelectorAll<HTMLElement>('[data-row]')];
    const cards = [...root.querySelectorAll<HTMLElement>('[data-card]')];
    const empty = root.querySelector<HTMLElement>('[data-empty]');
    let tier = 'all';
    let sortKey = 'vram';
    let dir = -1;

    const field = (el: HTMLElement) => (sortKey === 'name' || sortKey === 'arch'
      ? el.dataset[sortKey] || ''
      : Number(el.dataset[sortKey] || 0));

    const apply = () => {
      const query = q.value.trim().toLowerCase();
      let shown = 0;
      for (const el of [...rows, ...cards]) {
        const text = `${el.dataset.name || ''} ${el.dataset.arch || ''}`;
        const on = (tier === 'all' || el.dataset.tier === tier)
          && (vendor.value === 'all' || el.dataset.vendor === vendor.value)
          && (!query || text.includes(query));
        el.hidden = !on;
        if (on && el.hasAttribute('data-row')) shown += 1;
      }
      if (empty) empty.hidden = shown > 0;
      const vis = rows.filter((r) => !r.hidden);
      vis.sort((a, b) => {
        const av = field(a);
        const bv = field(b);
        if (av < bv) return -dir;
        if (av > bv) return dir;
        return 0;
      });
      for (const r of vis) body.append(r);
      for (const r of rows) if (r.hidden) body.append(r);
    };

    root.querySelectorAll<HTMLButtonElement>('.gpu__chip').forEach((btn) => {
      btn.addEventListener('click', () => {
        tier = btn.dataset.tier || 'all';
        root.querySelectorAll('.gpu__chip').forEach((c) => c.classList.toggle('is-on', c === btn));
        apply();
      });
    });
    vendor.addEventListener('change', apply);
    q.addEventListener('input', apply);
    root.querySelectorAll<HTMLButtonElement>('[data-sort]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const next = btn.dataset.sort || 'name';
        dir = sortKey === next ? -dir : next === 'name' || next === 'arch' ? 1 : -1;
        sortKey = next;
        apply();
      });
    });
  }

  // 侧边对比面板：从 JSON 读取数据集，预选两张卡即可实时对比，点击卡片按钮可换入。
  const cmpData = document.getElementById('gpu-cmp-data');
  const panel = document.querySelector<HTMLElement>('[data-cmp-panel]');
  if (cmpData && panel) {
    type CmpGpu = {
      slug: string; name: string; arch: string; vram: string; vramGb: number;
      bw: number; fp8: number; tdp: number; interconnect: string;
      cloud: string; savings: string; savingsPct: number;
    };
    type CmpPayload = {
      lang: string;
      gpus: CmpGpu[];
      labels: Record<string, string>;
    };
    let payload: CmpPayload;
    try {
      payload = JSON.parse(cmpData.textContent || '{}') as CmpPayload;
    } catch {
      payload = { lang: 'en', gpus: [], labels: {} };
    }
    const cats = payload.gpus;
    const L = payload.labels;
    const bySlug = new Map(cats.map((g) => [g.slug, g]));
    const selA = panel.querySelector<HTMLSelectElement>('[data-cmp-a]');
    const selB = panel.querySelector<HTMLSelectElement>('[data-cmp-b]');
    const rowsBox = panel.querySelector<HTMLElement>('[data-cmp-rows]');
    const nameA = panel.querySelector<HTMLElement>('[data-cmp-name-a]');
    const nameB = panel.querySelector<HTMLElement>('[data-cmp-name-b]');
    const table = panel.querySelector<HTMLTableElement>('.gpu__cmp-table');
    const empty = panel.querySelector<HTMLElement>('[data-cmp-empty]');
    const clearBtn = panel.querySelector<HTMLButtonElement>('[data-cmp-clear]');
    let slotA = selA?.value || '';
    let slotB = selB?.value || '';

    const link = (href: string, text: string) => {
      const a = document.createElement('a');
      a.href = href;
      a.textContent = text;
      return a;
    };

    const syncBtns = () => {
      document.querySelectorAll<HTMLButtonElement>('[data-compare-slug]').forEach((b) => {
        const on = Boolean(b.dataset.compareSlug && (b.dataset.compareSlug === slotA || b.dataset.compareSlug === slotB));
        b.classList.toggle('is-on', on);
        b.setAttribute('aria-pressed', String(on));
        b.textContent = on ? (L.selected || 'Selected') : (L.compare || 'Compare');
      });
    };

    const render = () => {
      const a = bySlug.get(slotA);
      const b = bySlug.get(slotB);
      const has = Boolean(a || b);
      if (table) table.hidden = !has;
      if (empty) empty.hidden = has;
      syncBtns();
      if ((!a && !b) || !rowsBox) return;

      if (nameA) nameA.replaceChildren(a ? link(`/${payload.lang}/gpus/${a.slug}/`, a.name) : document.createTextNode('—'));
      if (nameB) nameB.replaceChildren(b ? link(`/${payload.lang}/gpus/${b.slug}/`, b.name) : document.createTextNode('—'));
      if (rowsBox) rowsBox.replaceChildren();

      const rows: { label: string; a: string; b: string; hi?: 'a' | 'b'; workbench?: boolean }[] = [
        { label: L.arch || 'Architecture', a: a?.arch || '—', b: b?.arch || '—' },
        { label: L.vram || 'VRAM', a: a?.vram || '—', b: b?.vram || '—', hi: a && b ? (a.vramGb > b.vramGb ? 'a' : a.vramGb < b.vramGb ? 'b' : undefined) : undefined },
        { label: L.bw || 'Bandwidth', a: a ? `${a.bw.toLocaleString('en-US')} GB/s` : '—', b: b ? `${b.bw.toLocaleString('en-US')} GB/s` : '—', hi: a && b ? (a.bw > b.bw ? 'a' : a.bw < b.bw ? 'b' : undefined) : undefined },
        { label: L.fp8 || 'FP8', a: a ? `${a.fp8.toLocaleString('en-US')} TFLOPS` : '—', b: b ? `${b.fp8.toLocaleString('en-US')} TFLOPS` : '—', hi: a && b ? (a.fp8 > b.fp8 ? 'a' : a.fp8 < b.fp8 ? 'b' : undefined) : undefined },
        { label: L.tdp || 'TDP', a: a ? `${a.tdp} W` : '—', b: b ? `${b.tdp} W` : '—', hi: a && b ? (a.tdp < b.tdp ? 'a' : a.tdp > b.tdp ? 'b' : undefined) : undefined },
        { label: L.interconnect || 'Interconnect', a: a?.interconnect || '—', b: b?.interconnect || '—' },
        { label: L.cloud || 'Typical cloud', a: a?.cloud || '—', b: b?.cloud || '—' },
        { label: L.savings || 'Jev bypass savings', a: a?.savings || '—', b: b?.savings || '—', hi: a && b ? (a.savingsPct > b.savingsPct ? 'a' : a.savingsPct < b.savingsPct ? 'b' : undefined) : undefined },
      ];

      for (const row of rows) {
        const tr = document.createElement('tr');
        const th = document.createElement('th');
        th.scope = 'row';
        th.textContent = row.label;
        tr.append(th);
        for (const side of ['a', 'b'] as const) {
          const td = document.createElement('td');
          td.textContent = row[side];
          if (row.hi === side) td.classList.add('is-better');
          tr.append(td);
        }
        rowsBox.append(tr);
      }

      if (a || b) {
        const tr = document.createElement('tr');
        const th = document.createElement('th');
        th.scope = 'row';
        th.textContent = L.workbench || 'Workbench';
        tr.append(th);
        for (const gpu of [a, b]) {
          const td = document.createElement('td');
          td.append(gpu ? link(`/${payload.lang}/workbench/?gpu=${gpu.slug}`, L.workbench || 'Workbench') : document.createTextNode('—'));
          tr.append(td);
        }
        rowsBox.append(tr);
      }
    };

    const setSlot = (slug: string, which: 'a' | 'b') => {
      if (!bySlug.has(slug)) return;
      if (which === 'a') { slotA = slug; if (selA) selA.value = slug; }
      else { slotB = slug; if (selB) selB.value = slug; }
      render();
    };

    selA?.addEventListener('change', () => { slotA = selA.value; render(); });
    selB?.addEventListener('change', () => { slotB = selB.value; render(); });
    clearBtn?.addEventListener('click', () => {
      slotA = '';
      slotB = '';
      render();
    });

    for (const btn of document.querySelectorAll<HTMLButtonElement>('[data-compare-slug]')) {
      btn.addEventListener('click', () => {
        const slug = btn.dataset.compareSlug || '';
        if (!bySlug.has(slug)) return;
        // 轮换填入：优先 A，再 B，之后覆盖较旧的一侧。
        if (!slotA) setSlot(slug, 'a');
        else if (!slotB || slotB === slug) setSlot(slug, 'b');
        else if (!bySlug.has(slotB)) setSlot(slug, 'b');
        else setSlot(slug, 'a');

        panel.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      });
    }

    render();
  }
</script>

<style>
  .gpu__eyebrow { margin: 0; color: var(--accent); font-size: 0.8rem; letter-spacing: 0.04em; text-transform: uppercase; }
  .gpu__hero, .gpu__road img {
    margin: 1rem 0 0;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
    aspect-ratio: 16 / 9;
    background: var(--bg-code);
  }
  .gpu__hero img, .gpu__road img { display: block; width: 100%; height: 100%; object-fit: cover; }
  .gpu__bar { display: flex; flex-wrap: wrap; gap: 0.6rem; align-items: end; margin: 1.25rem 0; }
  .gpu__chips { display: flex; flex-wrap: wrap; gap: 0.35rem; }
  .gpu__chip, .gpu__vendor select, .gpu__search input {
    border: 1px solid var(--border);
    background: transparent;
    color: inherit;
    border-radius: 999px;
    min-height: 36px;
    padding: 0.3rem 0.75rem;
  }
  .gpu__chip.is-on { background: var(--accent-soft); border-color: var(--accent-border); }
  .gpu__vendor, .gpu__search { display: grid; gap: 0.2rem; font-size: 0.8rem; }
  .gpu__search input { border-radius: var(--radius); min-width: 12rem; }
  .gpu__sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
  .gpu__table-wrap { overflow-x: auto; }
  .gpu__table { width: 100%; border-collapse: collapse; font-size: 0.9rem; }
  .gpu__table th, .gpu__table td { text-align: left; padding: 0.55rem 0.45rem; border-bottom: 1px solid var(--border); white-space: nowrap; }
  .gpu__table button { background: none; border: 0; color: inherit; font: inherit; cursor: pointer; padding: 0; }
  .gpu__cards { list-style: none; padding: 0; display: grid; gap: 0.8rem; margin: 1rem 0 0; }
  @media (min-width: 800px) { .gpu__cards { grid-template-columns: 1fr 1fr; } }
  .gpu__cards li { border: 1px solid var(--border); border-radius: var(--radius); padding: 0.9rem 1rem; }
  .gpu__cards h2 { font-size: 1.05rem; margin: 0.2rem 0; }
  .gpu__meta { margin: 0; color: var(--muted); font-size: 0.78rem; }
  .gpu__cards dl { display: grid; grid-template-columns: 1fr 1fr; gap: 0.35rem 0.8rem; margin: 0.6rem 0; }
  .gpu__cards dt { color: var(--muted); font-size: 0.75rem; }
  .gpu__cards dd { margin: 0; }
  .gpu__card-actions { display: flex; flex-wrap: wrap; gap: 0.5rem; align-items: center; margin-top: 0.6rem; }
  .gpu__cmp-btn {
    border: 1px solid var(--border);
    background: transparent;
    color: inherit;
    border-radius: var(--radius);
    min-height: 36px;
    padding: 0 0.7rem;
    font: inherit;
    cursor: pointer;
  }
  .gpu__cmp-btn.is-on { background: var(--accent-soft); border-color: var(--accent-border); color: var(--accent); }
  .gpu__cmp { margin: 1rem 0 0; border: 1px solid var(--accent-border); border-radius: var(--radius); background: var(--bg-elev); padding: 0.9rem 1rem; }
  .gpu__cmp-head h2 { margin: 0 0 0.25rem; font-size: 1.05rem; }
  .gpu__cmp-head p { margin: 0; color: var(--muted); font-size: 0.82rem; }
  .gpu__cmp-pickers { display: flex; flex-wrap: wrap; gap: 0.6rem; align-items: end; margin: 0.8rem 0; }
  .gpu__cmp-pickers label { display: grid; gap: 0.2rem; font-size: 0.78rem; color: var(--muted); flex: 1 1 12rem; }
  .gpu__cmp-pickers select {
    border: 1px solid var(--border);
    background: var(--bg-elev-2);
    color: inherit;
    border-radius: var(--radius);
    min-height: 36px;
    padding: 0 0.5rem;
    font: inherit;
    max-width: 100%;
