---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { languages, pick, type Lang } from '../../i18n/ui';
import * as tryCopy from '../../i18n/pages/try';

export const prerender = true;

export function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const path = `/${lang}/try/`;
const copy = {
  title: pick(lang, tryCopy.title),
  lead: pick(lang, tryCopy.lead),
  state: pick(lang, tryCopy.state),
  run: pick(lang, tryCopy.run),
  running: pick(lang, tryCopy.running),
  share: pick(lang, tryCopy.share),
  copied: pick(lang, tryCopy.copied),
  ctaTitle: pick(lang, tryCopy.ctaTitle),
  ctaLead: pick(lang, tryCopy.ctaLead),
  ctaButton: pick(lang, tryCopy.ctaButton),
};
const clientCopy = pick(lang, tryCopy.client) as Record<string, string>;

const preset = {
  state: 'Help. My payouts have been failing for 3 days and I need this resolved today.',
  questions: {
    is_urgent: { type: 'noul', instructions: 'Does this convey urgency?' },
    intent: {
      type: 'choice',
      instructions: 'What does the sender want?',
      options: ['refund', 'status update', 'complaint', 'other'],
    },
  },
};
---

<BaseLayout lang={lang} title={copy.title} description={copy.lead} path={path}>
  <section class="section">
    <div class="wrap try">
      <p class="eyebrow"><span class="eyebrow__dot"></span>免费试用</p>
      <h1>{copy.title}</h1>
      <p class="try__lead">{copy.lead}</p>
      <p class="try__lead"><a href={`/${lang}/compare/`}>{pick(lang, tryCopy.compareLink)}</a></p>

      <label class="try__label" for="state">{copy.state}</label>
      <textarea id="state" rows="5">{preset.state}</textarea>

      <button class="btn btn--primary" id="run" type="button">{copy.run}</button>
      <p class="try__error" id="error" hidden></p>

      <div class="try__result" id="result" hidden>
        <div id="bars"></div>
        <a class="btn btn--ghost" id="share" href="#"></a>
        <aside class="try__cta">
          <p class="try__cta-title">{copy.ctaTitle}</p>
          <p class="try__cta-lead">{copy.ctaLead}</p>
          <a class="btn btn--primary" href={`/${lang}/login/?mode=register`}>{copy.ctaButton}</a>
        </aside>
      </div>
    </div>
  </section>
</BaseLayout>

<script define:vars={{ preset, copy, clientCopy, lang }}>
  const stateEl = document.getElementById('state');
  const runEl = document.getElementById('run');
  const errorEl = document.getElementById('error');
  const resultEl = document.getElementById('result');
  const barsEl = document.getElementById('bars');
  const shareEl = document.getElementById('share');

  function bar(label, value) {
    const pct = Math.round(Number(value) * 100);
    return `<div class="try__bar"><div class="try__bar-label"><span>${label}</span><b>${pct}%</b></div><div class="try__track"><span style="width:${pct}%"></span></div></div>`;
  }

  function render(record) {
    const html = [];
    for (const [name, answer] of Object.entries(record.answers || {})) {
      if (typeof answer.noul === 'number') html.push(bar(name, answer.noul));
      else if (answer.choice && answer.confidence) {
        html.push(`<p class="try__choice"><b>${name}</b> → ${answer.choice}</p>`);
        for (const [option, p] of Object.entries(answer.confidence)) html.push(bar(option, p));
      }
    }
    barsEl.innerHTML = html.join('');
    shareEl.href = `/${lang}/r/${record.id}/`;
    shareEl.textContent = copy.share;
    resultEl.hidden = false;
  }

  runEl.addEventListener('click', async () => {
    errorEl.hidden = true;
    const raw = stateEl.value.trim();
    if (!raw) { errorEl.hidden = false; errorEl.textContent = clientCopy.needState; return; }
    if (raw.length < 8) { errorEl.hidden = false; errorEl.textContent = clientCopy.tooShort; return; }
    if (raw.length > 4000) { errorEl.hidden = false; errorEl.textContent = clientCopy.tooLong; return; }
    runEl.disabled = true;
    runEl.classList.add('is-loading');
    runEl.textContent = copy.running;
    try {
      const res = await fetch('/api/try', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ state: stateEl.value, questions: preset.questions }),
      });
      const data = await res.json();
      if (!res.ok) throw new Error(clientCopy.failed);
      render(data);
      history.replaceState({}, '', `/${lang}/r/${data.id}/`);
    } catch (err) {
      errorEl.hidden = false;
      errorEl.textContent = clientCopy.failed;
    } finally {
      runEl.disabled = false;
      runEl.classList.remove('is-loading');
      runEl.textContent = copy.run;
    }
  });
</script>

<style>
  .try { max-width: 760px; }
  .try h1 { font-size: clamp(36px, 5vw, 56px); letter-spacing: -0.04em; margin: 12px 0; }
  .try__lead { color: var(--fg-muted); max-width: 62ch; }
  .try__label { display: block; margin: 22px 0 8px; font-size: 13px; font-weight: 600; color: var(--fg-muted); }
  textarea {
    width: 100%;
    box-sizing: border-box;
    border: 1px solid var(--border-strong);
    border-radius: 12px;
    background: var(--bg-elev);
    color: var(--fg);
    padding: 14px;
    font: inherit;
    resize: vertical;
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
  }
  textarea:focus {
    outline: none;
    border-color: var(--accent-border);
    box-shadow: 0 0 0 3px var(--accent-soft);
  }
  #run { margin-top: 16px; min-width: 140px; justify-content: center; }
  #run.is-loading { opacity: 0.75; cursor: progress; }
  .try__error { color: var(--rose); }
  .try__result { margin-top: 28px; display: grid; gap: 14px; }
  .try__cta {
    margin-top: 8px; padding: 18px;
    border: 1px solid var(--border-strong); border-radius: 12px;
    background: var(--bg-elev);
    display: grid; gap: 8px; justify-items: start;
  }
  .try__cta-title { font-weight: 600; margin: 0; }
  .try__cta-lead { margin: 0; font-size: 14px; color: var(--fg-dim); }
  .try__cta .btn { margin-top: 6px; }
  .try__bar-label, .try__choice { display: flex; justify-content: space-between; gap: 12px; font-size: 14px; }
  .try__track { height: 8px; border-radius: 99px; background: var(--bg-code); overflow: hidden; margin: 6px 0 12px; }
  .try__track span { display: block; height: 100%; background: var(--accent); }
</style>
