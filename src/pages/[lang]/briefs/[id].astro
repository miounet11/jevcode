---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { languages, pick, useTranslations, type Lang } from '../../../i18n/ui';
import * as copySrc from '../../../i18n/pages/briefs';
import briefs from '../../../data/daily-briefs.json';
import { briefHeading, localizedBrief, localizeTerm } from '../../../../scripts/lib/daily-briefs.mjs';
import briefI18n from '../../../data/briefs-i18n.json';
import { briefTerms } from '../../../data/brief-terms';

type Judgment = {
  ok: boolean;
  choice: string | null;
  model: string | null;
  ts: string;
  probabilities?: Record<string, number>;
};
type Brief = {
  id: string;
  published: string;
  industry: string;
  dimension: string;
  tag: string;
  scene: string;
  stage: string;
  context: string;
  question: string;
  choices: string[];
  accept: string[];
  judgment: Judgment | null;
};

const rows = briefs as Brief[];

export function getStaticPaths() {
  const paths: Array<{ params: { lang: string; id: string } }> = [];
  for (const lang of Object.keys(languages)) {
    for (const row of briefs as Brief[]) paths.push({ params: { lang, id: row.id } });
  }
  return paths;
}

const { lang } = Astro.params as { lang: Lang };
const t = useTranslations(lang);
const entry = rows.find((row) => row.id === Astro.params.id);
if (!entry) throw new Error(`unknown brief: ${Astro.params.id}`);

const path = `/${lang}/briefs/${entry.id}/`;
const copy = {
  crumb: pick(lang, copySrc.title),
  back: pick(lang, copySrc.back),
  published: pick(lang, copySrc.published),
  context: pick(lang, copySrc.contextLabel),
  question: pick(lang, copySrc.questionLabel),
  choices: pick(lang, copySrc.choicesLabel),
  accept: pick(lang, copySrc.acceptLabel),
  judgment: pick(lang, copySrc.judgmentLabel),
  probabilities: pick(lang, copySrc.probabilitiesLabel),
  noJudgment: pick(lang, copySrc.noJudgment),
};
const text = localizedBrief(entry, lang, briefI18n as Record<string, Record<string, { context: string; question: string; choices: string[] }>>);
const flat = text.context.replace(/\s+/g, ' ').trim();
const desc = Array.from(flat).slice(0, 160).join('') + (Array.from(flat).length > 160 ? '…' : '');
// 标题用可区分的结构化字段：question 在语料里按维度模板重复，直接当 h1 会
// 产出一批同标题页面。语言站点按术语表产出各自的标题与描述。
const heading = briefHeading(entry, lang, briefTerms);
const pageTitle = `${heading} — ${Array.from(text.question).slice(0, 60).join('')}`;
// 有译文的语言才进索引；未本地化的页面留在英文原文上，不重复收录。
const detailIndex = lang === 'en' || lang === 'zh' || text.localized;
const bodyLang = text.localized ? lang : 'en';
const idx = rows.findIndex((row) => row.id === entry.id);
const prev = idx > 0 ? rows[idx - 1] : undefined;
const next = idx >= 0 && idx < rows.length - 1 ? rows[idx + 1] : undefined;
const hrefOf = (row: Brief) => `/${lang}/briefs/${row.id}/`;
// 每页正文就是一次「情境 + 问题 → 判定」，但之前只挂了全站 Organization/
// WebSite 这一类节点，搜索引擎只能当普通网页读。补 QAPage + BreadcrumbList：
// 前者让答案可以被直接取用，后者给出它在站内的层级位置。
const accepted = entry.accept.map((choice) => localizeTerm('choice', choice, lang, briefTerms));
const canonical = new URL(path, Astro.site).href;
// 只有真的记下了判定才声明答案。answerCount 与 acceptedAnswer 必须同时存在或
// 同时缺席：声明 answerCount: 1 却不给 acceptedAnswer，等于对外声称「有答案」
// 而正文里没有，QAPage 会被判为元数据不完整。
const judged = entry.judgment?.ok && entry.judgment.choice ? entry.judgment : undefined;
const answerNode: Record<string, unknown> | undefined = judged
  ? {
      '@type': 'Answer',
      text: (() => {
        const chosen = localizeTerm('choice', judged.choice, lang, briefTerms);
        // accept 常常只有一个选项、且与判定相同，直接拼会得到「是（是）」。
        // 只在确实存在其它可接受选项时才附注。
        const others = accepted.filter((a) => a !== chosen);
        return others.length ? `${chosen}（可接受：${others.join(' / ')}）` : chosen;
      })(),
      inLanguage: bodyLang,
      // ts 理论上总有，但旧数据里出现过缺字段的记录；slice 一个 undefined 会
      // 在构建时直接抛错，整个站点构建失败，不值得为一行日期冒这个险。
      ...(typeof judged.ts === 'string' ? { dateCreated: judged.ts.slice(0, 10) } : {}),
    }
  : undefined;
const pageSchema: Record<string, unknown>[] = [
  {
    '@type': 'QAPage',
    '@id': `${canonical}#qa`,
    mainEntity: {
      '@type': 'Question',
      name: text.question,
      text: flat,
      inLanguage: bodyLang,
      answerCount: answerNode ? 1 : 0,
      ...(answerNode ? { acceptedAnswer: answerNode } : {}),
    },
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: t('site.name'), item: new URL(`/${lang}/`, Astro.site).href },
      { '@type': 'ListItem', position: 2, name: copy.crumb, item: new URL(`/${lang}/briefs/`, Astro.site).href },
      { '@type': 'ListItem', position: 3, name: heading, item: canonical },
    ],
  },
];
---

<BaseLayout lang={lang} title={pageTitle} description={desc} path={path} index={detailIndex} schema={pageSchema}>
  <section class="section">
    <div class="wrap">
      <main class="doc">
        <p class="doc__breadcrumb">
          <a href={`/${lang}/`}>{t('site.name')}</a>
          /
          <a href={`/${lang}/briefs/`}>{copy.crumb}</a>
          / {entry.id}
        </p>
        <h1 class="doc__title">{heading}</h1>
        <p class="doc__desc">{localizeTerm('dimension', entry.dimension, lang, briefTerms)} · {localizeTerm('stage', entry.stage, lang, briefTerms)}</p>
        <div class="pmeta">
          <span class="pmeta__item"><span class="pmeta__k">{copy.published}</span><span class="pmeta__v">{entry.published}</span></span>
          <span class="pmeta__item"><span class="pmeta__k">tag</span><span class="pmeta__v">{localizeTerm('tag', entry.tag, lang, briefTerms)}</span></span>
          <span class="pmeta__item"><span class="pmeta__k">stage</span><span class="pmeta__v">{localizeTerm('stage', entry.stage, lang, briefTerms)}</span></span>
        </div>
        <h2>{copy.context}</h2>
        <blockquote class="pquote"><p class="pquote__text" lang={bodyLang}>{text.context}</p></blockquote>
        <h2>{copy.question}</h2>
        <p lang={bodyLang}>{text.question}</p>
        <h2>{copy.choices}</h2>
        <ul>
          {/* 选项显示本地化词，但键仍是英文 slug：判分与 accept 都按英文键走。 */}
          {text.choices.map((choice: string) => (
            <li><code>{localizeTerm('choice', choice, lang, briefTerms)}</code></li>
          ))}
        </ul>
        <h2>{copy.accept}</h2>
        {entry.accept.length
          ? <ul>{entry.accept.map((choice) => <li><code>{localizeTerm('choice', choice, lang, briefTerms)}</code></li>)}</ul>
          : <p>—</p>}
        <h2>{copy.judgment}</h2>
        {entry.judgment?.ok && entry.judgment.choice
          ? <p><code>{localizeTerm('choice', entry.judgment.choice, lang, briefTerms)}</code> · {entry.judgment.model} · {entry.judgment.ts.slice(0, 10)}</p>
          : <p>{copy.noJudgment}</p>}
        {/* 概率分布：模型对每个选项的置信度。缺它时页面只有一个是/否，
            无法回答「模型有多确定」，而后者才是读者（和 AI 引擎）真正想知道的。 */}
        {entry.judgment?.probabilities && Object.keys(entry.judgment.probabilities).length > 0 && (
          <>
            <h2>{copy.probabilities}</h2>
            <table class="ptable">
              <thead>
                <tr><th>{copy.choices}</th><th>%</th></tr>
              </thead>
              <tbody>
                {entry.choices.map((choice) => {
                  const p = entry.judgment?.probabilities?.[choice];
                  return (
                    <tr>
                      <td><code>{localizeTerm('choice', choice, lang, briefTerms)}</code></td>
                      <td>{typeof p === 'number' ? `${(p * 100).toFixed(1)}%` : '—'}</td>
                    </tr>
                  );
                })}
              </tbody>
            </table>
          </>
        )}
        {(prev || next) && (
          <nav class="pager" aria-label="Pagination">
            {prev ? (
              <a class="pager__link" href={hrefOf(prev)}>
                <div class="pager__dir">←</div>
                <div class="pager__name">{prev.id}</div>
              </a>
            ) : <span></span>}
            {next && (
              <a class="pager__link pager__link--next" href={hrefOf(next)}>
                <div class="pager__dir">→</div>
                <div class="pager__name">{next.id}</div>
              </a>
            )}
          </nav>
        )}
        <p class="pback"><a href={`/${lang}/briefs/`}>{copy.back}</a></p>
      </main>
    </div>
  </section>
</BaseLayout>

<style>
  .pmeta { display: flex; flex-wrap: wrap; gap: 10px 26px; margin: 18px 0 22px; }
  .pmeta__item { display: flex; align-items: baseline; gap: 7px; }
  /* opacity 会连字重一起变淡，0.62 时对比度只剩 2.27:1。改用 token 色保留层级。 */
  .pmeta__k { font-size: 12px; letter-spacing: 0.04em; text-transform: uppercase; color: var(--fg-dim); }
  .pquote { margin: 8px 0 22px; padding: 12px 16px; border-left: 3px solid var(--accent); }
  .pquote__text { margin: 0; white-space: pre-wrap; }
  .pback { margin-top: 28px; }
</style>
