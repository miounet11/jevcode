---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { languages, pick, type Lang } from '../../../i18n/ui';
import { CODE_RECIPES } from '../../../data/recipes';
import * as copy from '../../../i18n/pages/recipes';

export function getStaticPaths() {
  return (Object.keys(languages) as Lang[]).map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: Lang };
const path = `/${lang}/recipes/`;
const title = pick(lang, copy.title);
const description = pick(lang, copy.description);
const hubUrl = new URL(path, Astro.site).href;

const t = {
  eyebrow: pick(lang, copy.eyebrow),
  lead: pick(lang, copy.lead),
  filterAll: pick(lang, copy.filterAll),
  filterLanguage: pick(lang, copy.filterLanguage),
  filterBlueprint: pick(lang, copy.filterBlueprint),
  searchPlaceholder: pick(lang, copy.searchPlaceholder),
  kindLanguage: pick(lang, copy.kindLanguage),
  kindBlueprint: pick(lang, copy.kindBlueprint),
  runtimeLabel: pick(lang, copy.runtimeLabel),
  latencyLabel: pick(lang, copy.latencyLabel),
  viewRecipe: pick(lang, copy.viewRecipe),
};

const cards = CODE_RECIPES.map((r) => ({
  slug: r.slug,
  kind: r.kind,
  runtime: r.runtime,
  latency: r.latencyProfile,
  file: r.sourceFilename,
  title: pick(lang, r.title),
  tagline: pick(lang, r.tagline),
  href: `/${lang}/recipes/${r.slug}/`,
}));

const schema = [
  {
    '@type': 'CollectionPage',
    name: title,
    url: hubUrl,
    description,
    inLanguage: lang,
    mainEntity: {
      '@type': 'ItemList',
      numberOfItems: cards.length,
      itemListElement: cards.map((card, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        name: card.title,
        url: new URL(card.href, Astro.site).href,
      })),
    },
  },
];
---

<BaseLayout lang={lang} title={title} description={description} path={path} schema={schema}>
  <div class="wrap docs-shell">
    <div class="doc">
      <p class="rx-eyebrow">{t.eyebrow}</p>
      <h1 class="doc__title">{title}</h1>
      <p class="doc__desc">{t.lead}</p>
      <img
        class="rx-hero"
        src="/img/guides/recipes-hero.webp"
        alt={title}
        width="1344"
        height="768"
        loading="eager"
        decoding="async"
      />

      <div class="rx-filter">
        <div role="tablist" aria-label={title}>
          <button type="button" role="tab" data-kind="all" aria-selected="true">{t.filterAll}</button>
          <button type="button" role="tab" data-kind="language" aria-selected="false">{t.filterLanguage}</button>
          <button type="button" role="tab" data-kind="blueprint" aria-selected="false">{t.filterBlueprint}</button>
        </div>
        <input type="search" data-recipe-search placeholder={t.searchPlaceholder} aria-label={t.searchPlaceholder} />
      </div>

      <ul class="rx-grid">
        {cards.map((card) => (
          <li data-recipe data-kind={card.kind} data-q={`${card.title} ${card.tagline} ${card.runtime} ${card.file} ${card.slug}`.toLowerCase()}>
            <article>
              <p class="rx-badges">
                <span>{card.kind === 'language' ? t.kindLanguage : t.kindBlueprint}</span>
                <span>{t.runtimeLabel}: {card.runtime}</span>
                <span>{t.latencyLabel}: {card.latency}</span>
              </p>
              <h2><a href={card.href}>{card.title}</a></h2>
              <p>{card.tagline}</p>
              <p class="rx-file"><code>{card.file}</code></p>
              <a class="rx-open" href={card.href}>{t.viewRecipe}</a>
            </article>
          </li>
        ))}
      </ul>
    </div>
  </div>
</BaseLayout>

<script>
  const tabs = [...document.querySelectorAll<HTMLButtonElement>('[data-kind]')];
  const input = document.querySelector<HTMLInputElement>('[data-recipe-search]');
  const items = [...document.querySelectorAll<HTMLElement>('[data-recipe]')];
  let kind = 'all';
  let q = '';

  function apply() {
    for (const item of items) {
      const okKind = kind === 'all' || item.dataset.kind === kind;
      const okQ = !q || (item.dataset.q ?? '').includes(q);
      item.hidden = !(okKind && okQ);
    }
  }

  for (const tab of tabs) {
    tab.addEventListener('click', () => {
      kind = tab.dataset.kind ?? 'all';
      for (const other of tabs) other.setAttribute('aria-selected', String(other === tab));
      apply();
    });
  }
  input?.addEventListener('input', () => {
    q = input.value.trim().toLowerCase();
    apply();
  });
</script>

<style>
  .rx-eyebrow {
    margin: 0 0 8px;
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .rx-hero {
    width: 100%;
    height: auto;
    border-radius: var(--radius);
    border: 1px solid var(--border);
    margin: 0 0 22px;
  }
  .rx-filter {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    align-items: center;
    margin-bottom: 18px;
  }
  .rx-filter [role="tablist"] { display: flex; gap: 6px; flex-wrap: wrap; }
  .rx-filter button, .rx-filter input {
    min-height: 44px;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--bg-elev);
    color: var(--fg);
    font: inherit;
  }
  .rx-filter button { padding: 0 14px; cursor: pointer; color: var(--fg-muted); }
  .rx-filter button[aria-selected="true"] {
    color: var(--accent);
    border-color: var(--accent-border);
    background: var(--accent-soft);
  }
  .rx-filter input { flex: 1 1 220px; padding: 0 12px; }
  .rx-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 14px;
  }
  .rx-grid article {
    height: 100%;
    padding: 14px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--bg-elev);
  }
  .rx-badges { display: flex; flex-wrap: wrap; gap: 6px; margin: 0 0 8px; }
  .rx-badges span, .rx-file {
    font-size: 12px;
    color: var(--fg-dim);
  }
  .rx-grid h2 { font-size: 1.05rem; margin: 0 0 8px; line-height: 1.3; }
  .rx-grid h2 a { color: var(--fg); text-decoration: none; }
  .rx-grid h2 a:hover { color: var(--accent); }
  .rx-grid p { margin: 0 0 10px; color: var(--fg-muted); font-size: 14px; }
  .rx-open { font-size: 14px; font-weight: 600; }
</style>
