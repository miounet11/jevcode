---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { languages, pick, type Lang } from '../../i18n/ui';
import * as pricingCopy from '../../i18n/pages/pricing';
import { SIGNUP_CREDIT_CENTS, SIGNUP_INPUT_TOKENS, centsToUsd } from '../../../server/plans.mjs';

export const prerender = true;

export function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const path = `/${lang}/pricing/`;
const signupUsd = centsToUsd(SIGNUP_CREDIT_CENTS);
const tokenCount = SIGNUP_INPUT_TOKENS.toLocaleString('en-US');

const copy = {
  title: pick(lang, pricingCopy.title),
  lead: pick(lang, pricingCopy.lead),
  scheme: pick(lang, pricingCopy.scheme),
  perMillion: pick(lang, pricingCopy.perMillion),
  outputFree: pick(lang, pricingCopy.outputFree),
  signup: pick(lang, pricingCopy.signup),
  inputTokens: pick(lang, pricingCopy.inputTokens),
  cta: pick(lang, pricingCopy.cta),
  cols: pick(lang, pricingCopy.cols),
  rows: pick(lang, pricingCopy.rows).map(([a, b]) => [a, b.replace('{credit}', `$${signupUsd}`).replace('{tokens}', tokenCount)] as [string, string]),
  note: pick(lang, pricingCopy.note),
  back: pick(lang, pricingCopy.back),
};

---

<BaseLayout lang={lang} title={copy.title} description={copy.lead} path={path}>
  <section class="section">
    <div class="wrap pricing">
      <p class="eyebrow"><span class="eyebrow__dot"></span>{copy.title}</p>
      <h1>{copy.title}</h1>
      <p class="pricing__lead">{copy.lead}</p>

      <div class="pricing__cards">
        <div class="pricing__card pricing__card--featured">
          <h2>{copy.scheme}</h2>
          <p class="pricing__price"><b>$0.042</b> <span>{copy.perMillion}</span></p>
          <p class="pricing__quota">{copy.outputFree}</p>
          <p class="pricing__quota">
            {copy.signup}: <b>${signupUsd}</b> &middot; {tokenCount} {copy.inputTokens}
          </p>
          <a class="btn btn--primary" href={`/${lang}/login/`}>{copy.cta}</a>
        </div>
      </div>

      <table class="pricing__table">
        <thead>
          <tr>
            <th>{copy.cols.item}</th>
            <th>{copy.cols.value}</th>
          </tr>
        </thead>
        <tbody>
          {copy.rows.map(([label, value]) => (
            <tr>
              <td>{label}</td>
              <td>{value}</td>
            </tr>
          ))}
        </tbody>
      </table>

      <p class="pricing__note">{copy.note}</p>
      <a class="btn btn--ghost" href={`/${lang}/try/`}>{copy.back}</a>
    </div>
  </section>
</BaseLayout>

<style>
  .pricing { max-width: 860px; }
  .pricing h1 { font-size: clamp(34px, 5vw, 52px); letter-spacing: -0.04em; margin: 12px 0; }
  .pricing__lead { color: var(--fg-muted); max-width: 62ch; }
  .pricing__cards { display: grid; gap: 16px; max-width: 420px; margin: 28px 0; }
  .pricing__card {
    border: 1px solid var(--border-strong);
    border-radius: 14px;
    padding: 20px;
    background: var(--bg-elev);
    display: grid;
    gap: 10px;
  }
  .pricing__card--featured { border-color: var(--accent); }
  .pricing__card h2 { margin: 0; font-size: 18px; }
  .pricing__price { margin: 0; font-size: 30px; letter-spacing: -0.03em; }
  .pricing__price span { font-size: 13px; color: var(--fg-dim); }
  .pricing__quota { margin: 0; color: var(--fg-muted); font-size: 14px; }
  .pricing__table { width: 100%; border-collapse: collapse; margin: 8px 0 20px; font-size: 14px; }
  .pricing__table th, .pricing__table td { text-align: left; padding: 10px 8px; border-bottom: 1px solid var(--border); }
  .pricing__table th { color: var(--fg-dim); font-weight: 500; }
  .pricing__note { color: var(--fg-dim); font-size: 13px; margin-bottom: 18px; }
</style>
