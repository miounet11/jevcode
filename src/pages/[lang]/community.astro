---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { languages, useTranslations, type Lang } from '../../i18n/ui';
import { pulseEntries, pulseCategories, categorize } from '../../data/community';

export function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: Lang };
const t = useTranslations(lang);

const path = `/${lang}/community/`;

const copy =
  lang === 'zh'
    ? {
        title: '社区脉搏',
        lead: 'Jev 正在被用来做什么：社区推文精选，看真实项目、演示与讨论。每条注明原作者并链接原推。',
        stats: '条精选',
        viewOriginal: '查看原推',
        project: '项目链接',
        asOf: '收录时间',
        all: '全部',
        note: '条目为英文原文摘录，筛选标准：显著传播量或附项目链接；经 Jev 批级相关性判定。',
      }
    : {
        title: 'Community pulse',
        lead: 'What Jev is being used for: curated community posts — real projects, demos, and discussion. Every entry is attributed and linked to the original.',
        stats: 'entries',
        viewOriginal: 'View original',
        project: 'Project',
        asOf: 'Collected',
        all: 'All',
        note: 'Entries are excerpts of original posts. Inclusion bar: significant engagement or an attached project link; batch relevance judged by Jev.',
      };

const groups = pulseCategories.map((c) => ({
  key: c.key,
  title: c.title[lang] ?? c.title.en,
  items: pulseEntries.filter((e) => categorize(e.text) === c.key),
}));

const fmt = (n: number) => (n >= 1_000_000 ? `${(n / 1_000_000).toFixed(1)}M` : n >= 1000 ? `${(n / 1000).toFixed(1)}k` : String(n));
const dateShort = (iso: string) => iso.slice(0, 10);
---

<BaseLayout lang={lang} title={copy.title} description={copy.lead} path={path}>
  <div class="wrap docs-shell">
    <main class="doc">
      <p class="doc__breadcrumb">
        <a href={`/${lang}/`}>{t('site.name')}</a> / {copy.title}
      </p>

      <h1 class="doc__title">{copy.title}</h1>
      <p class="doc__desc">{copy.lead}</p>

      <div class="stats__grid stats__grid--single">
        <div class="stat">
          <div class="stat__num">{pulseEntries.length}</div>
          <div class="stat__label">{copy.stats}</div>
        </div>
      </div>

      <p class="pulse__note">{copy.note}</p>

      {groups.map((g) => g.items.length > 0 && (
        <section class="pulse">
          <div class="section__head">
            <h2 class="section__title">{g.title}</h2>
          </div>
          <div class="pulse__list">
            {g.items.map((e) => (
              <article class="pulse__card">
                <div class="pulse__head">
                  <span class="pulse__author">{e.author}</span>
                  <span class="pulse__handle">@{e.screenName}</span>
                  <span class="pulse__date">{dateShort(e.date)}</span>
                  <span class="pulse__views" title="views">▲ {fmt(e.views)}</span>
                </div>
                <p class="pulse__text" lang="en">{e.text}</p>
                <div class="pulse__actions">
                  <a class="pulse__link" href={e.url} target="_blank" rel="noopener noreferrer">{copy.viewOriginal} ↗</a>
                  {e.projectUrl && (
                    <a class="pulse__link pulse__link--proj" href={e.projectUrl} target="_blank" rel="noopener noreferrer">{copy.project} ↗</a>
                  )}
                </div>
              </article>
            ))}
          </div>
        </section>
      ))}
    </main>
  </div>
</BaseLayout>

<style>
  /* 本页 stats 只有 1 个瓦片，全局 .stats__grid 的 repeat(4,1fr) 会让其余 3 列只露出 --border 底色。
     用页面级类收成单列 + 宽度贴合内容，避免影响首页(4 瓦片)/生态页(3 瓦片)。 */
  .stats__grid--single {
    grid-template-columns: minmax(0, max-content);
  }
  .pulse__note {
    color: var(--fg-dim);
    font-size: 12.5px;
    border-left: 3px solid var(--border-strong);
    padding-left: 10px;
    max-width: 72ch;
  }
  .pulse {
    margin-top: 30px;
  }
  .pulse__list {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
    gap: 14px;
  }
  .pulse__card {
    background: var(--bg-elev);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 16px 18px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    transition: border-color 0.15s ease;
  }
  .pulse__card:hover {
    border-color: var(--accent-border);
  }
  .pulse__head {
    display: flex;
    align-items: baseline;
    gap: 8px;
    flex-wrap: wrap;
  }
  .pulse__author {
    font-weight: 600;
    font-size: 13.5px;
  }
  .pulse__handle {
    font-family: var(--font-mono);
    font-size: 11.5px;
    color: var(--fg-dim);
  }
  .pulse__date {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--fg-dim);
    margin-left: auto;
  }
  .pulse__views {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--accent);
  }
  .pulse__text {
    margin: 0;
    font-size: 13.5px;
    line-height: 1.65;
    color: var(--fg-muted);
    white-space: pre-line;
    display: -webkit-box;
    -webkit-line-clamp: 8;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .pulse__actions {
    display: flex;
    gap: 14px;
    margin-top: auto;
  }
  .pulse__link {
    font-size: 12.5px;
    font-weight: 600;
  }
  .pulse__link--proj {
    color: var(--accent);
  }
</style>
