---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { languages, useTranslations, type Lang } from '../../i18n/ui';
import { pulseEntries, pulseCategories, categorize } from '../../data/community';

export function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: Lang };
const t = useTranslations(lang);

const path = `/${lang}/community/`;

const copy =
  lang === 'zh'
    ? {
        title: '社区脉搏',
        lead: 'Jev 正在被用来做什么：社区推文精选，看真实项目、演示与讨论。打开任一条可看到原文摘录全文与出处。',
        stats: '条精选',
        open: '查看详情',
        asOf: '收录时间',
        all: '全部',
        note: '条目为英文原文摘录，筛选标准：显著传播量或附项目链接；经 Jev 批级相关性判定。',
      }
    : {
        title: 'Community pulse',
        lead: 'What Jev is being used for: curated community posts — real projects, demos, and discussion. Open any entry for the full excerpt and its source.',
        stats: 'entries',
        open: 'Read entry',
        asOf: 'Collected',
        all: 'All',
        note: 'Entries are excerpts of original posts. Inclusion bar: significant engagement or an attached project link; batch relevance judged by Jev.',
      };

const groups = pulseCategories.map((c) => ({
  key: c.key,
  title: c.title[lang] ?? c.title.en,
  items: pulseEntries.filter((e) => categorize(e.text) === c.key),
}));

const fmt = (n: number) => (n >= 1_000_000 ? `${(n / 1_000_000).toFixed(1)}M` : n >= 1000 ? `${(n / 1000).toFixed(1)}k` : String(n));
const dateShort = (iso: string) => iso.slice(0, 10);
---

<BaseLayout lang={lang} title={copy.title} description={copy.lead} path={path}>
  <section class="section">
    <div class="wrap">
      <main class="doc">
        <p class="doc__breadcrumb">
          <a href={`/${lang}/`}>{t('site.name')}</a> / {copy.title}
        </p>

        <h1 class="doc__title">{copy.title}</h1>
        <p class="doc__desc">{copy.lead}</p>

        <div class="stats__grid stats__grid--single">
          <div class="stat">
            <div class="stat__num">{pulseEntries.length}</div>
            <div class="stat__label">{copy.stats}</div>
          </div>
        </div>

        <p class="pulse__note">{copy.note}</p>

        {groups.map((g) => g.items.length > 0 && (
          <section class="pulse">
            <div class="section__head">
              <h2 class="section__title">{g.title}</h2>
            </div>
            <div class="pulse__list">
              {g.items.map((e) => (
                // 整卡是站内链接：此前卡上两个锚点都指向站外，点一下就离开本站。
                // 现在主点击进入本站介绍页，站外链接只留在介绍页上。
                <a class="pulse__card" href={`/${lang}/community/${e.id}/`}>
                  <div class="pulse__head">
                    <span class="pulse__author">{e.author}</span>
                    <span class="pulse__handle">@{e.screenName}</span>
                    <span class="pulse__date">{dateShort(e.date)}</span>
                    <span class="pulse__views" title="views">▲ {fmt(e.views)}</span>
                  </div>
                  <p class="pulse__text" lang="en">{e.text}</p>
                  <div class="pulse__actions">
                    <span class="pulse__link">{copy.open} →</span>
                  </div>
                </a>
              ))}
            </div>
          </section>
        ))}
      </main>
    </div>
  </section>
</BaseLayout>

<style>
  /* 本页 stats 只有 1 个瓦片，全局 .stats__grid 的 repeat(4,1fr) 会让其余 3 列只露出 --border 底色。
     用页面级类收成单列 + 宽度贴合内容，避免影响首页(4 瓦片)/生态页(3 瓦片)。 */
  .stats__grid--single {
    grid-template-columns: minmax(0, max-content);
  }
  .pulse__note {
    color: var(--fg-dim);
    font-size: 12.5px;
    border-left: 3px solid var(--border-strong);
    padding-left: 10px;
    max-width: 72ch;
  }
  .pulse {
    margin-top: 30px;
  }
  .pulse__list {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(340px, 100%), 1fr));
    gap: 14px;
  }
  /* 整卡是链接：必须显式抵消全局 a 的 accent 色与 hover 下划线，
     否则整段原文会被当链接染色、hover 时整卡出现下划线。 */
  .pulse__card {
    background: var(--bg-elev);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 16px 18px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    transition: border-color 0.15s ease;
    color: inherit;
    text-decoration: none;
  }
  .pulse__card:hover {
    border-color: var(--accent-border);
    text-decoration: none;
  }
  .pulse__head {
    display: flex;
    align-items: baseline;
    gap: 8px;
    flex-wrap: wrap;
  }
  .pulse__author {
    font-weight: 600;
    font-size: 13.5px;
  }
  .pulse__handle {
    font-family: var(--font-mono);
    font-size: 11.5px;
    color: var(--fg-dim);
  }
  .pulse__date {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--fg-dim);
    margin-left: auto;
  }
  .pulse__views {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--accent);
  }
  .pulse__text {
    margin: 0;
    font-size: 13.5px;
    line-height: 1.65;
    color: var(--fg-muted);
    white-space: pre-line;
    display: -webkit-box;
    -webkit-line-clamp: 8;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .pulse__actions {
    display: flex;
    gap: 14px;
    margin-top: auto;
  }
  .pulse__link {
    font-size: 12.5px;
    font-weight: 600;
    color: var(--accent);
  }
</style>
