---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { languages, useTranslations, pick, type Lang } from '../../i18n/ui';
import { primitiveCards, patternCards } from '../../data/site';
import { projects } from '../../data/ecosystem';
import { pulseEntries } from '../../data/community';
import Figure from '../../components/Figure.astro';
import Cluster from '../../components/Cluster.astro';
import { heroFigure } from '../../data/images';
import { compareCases } from '../../data/compare-cases';
import * as homeCopy from '../../i18n/pages/home';

export function getStaticPaths() {
  return (Object.keys(languages) as Lang[]).map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: Lang };
const t = useTranslations(lang);

const all = await getCollection('docs', ({ data }) => !data.draft);
const docsCount = all.filter((e) => e.id.startsWith(`${lang}/`)).length || all.length;

const stats = [
  { num: '1', label: t('home.stats.models') },
  { num: '3', label: t('home.stats.primitives') },
  { num: '4+', label: t('home.stats.patterns') },
  { num: '20+', label: t('home.stats.cases') },
];

const destinations = [
  { href: `/${lang}/introduction/`, title: t('home.dest.docs'), desc: t('home.dest.docs.desc') },
  { href: `/${lang}/quickstart/`, title: t('home.dest.start'), desc: t('home.dest.start.desc') },
  { href: `/${lang}/ecosystem/`, title: t('home.dest.eco'), desc: t('home.dest.eco.desc') },
  { href: `/${lang}/community/`, title: t('home.dest.pulse'), desc: t('home.dest.pulse.desc') },
];

const freshDocs = all
  .filter((e) => e.id.startsWith(`${lang}/`))
  .sort((a, b) => b.data.order - a.data.order)
  .slice(0, 4);

const featuredProjects = [...projects].sort((a, b) => b.stars - a.stars).slice(0, 4);
const featuredPulse = [...pulseEntries].sort((a, b) => b.likes - a.likes).slice(0, 3);
const fmtStars = (n: number) => (n >= 1000 ? `${(n / 1000).toFixed(1)}k` : String(n));

const trialLabels = pick(lang, homeCopy.trialLabels);
const trialGroups = Object.keys(trialLabels).map((category) => ({
  category,
  label: trialLabels[category],
  items: compareCases.filter((item) => item.category === category).slice(0, 5),
}));

const path = `/${lang}/`;

const faqs = pick(lang, homeCopy.faqs);
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
};
---

<BaseLayout lang={lang} title={t('site.name')} path={path} cluster={false}>
  <section class="hero">
    <div class="wrap hero__inner">
      <p class="eyebrow">
        <span class="eyebrow__dot"></span>
        {t('home.hero.eyebrow')}
      </p>
      <h1>{t('home.hero.title')}</h1>
      <p class="hero__lead">{t('home.hero.lead')}</p>
      <div class="cta-row">
        <a class="btn btn--primary" href="#trials">{pick(lang, homeCopy.hero.ctaPrimary)} →</a>
        <a class="btn btn--ghost" href={`/${lang}/try/`}>{pick(lang, homeCopy.hero.ctaSecondary)}</a>
        <a class="btn btn--ghost" href={`/${lang}/introduction/`}>{t('home.hero.cta')}</a>
      </div>
      <a class="hero__stage" href="#trials">
        <span><small>clavue-jev</small><strong>{pick(lang, homeCopy.hero.stageOurs)}</strong></span>
        <em>vs</em>
        <span><small>jev-1.13.0</small><strong>{pick(lang, homeCopy.hero.stagePeer)}</strong></span>
        <b>{pick(lang, homeCopy.hero.stageHint)}</b>
      </a>
      <Figure fig={heroFigure} lang={lang} priority class="figure--hero" />
    </div>
  </section>

  <section class="section bench" id="trials">
    <div class="wrap">
      <div class="bench__top">
        <div>
          <p class="eyebrow"><span class="eyebrow__dot"></span>clavue-jev</p>
          <h2>{t('home.models.title')}</h2>
          <p>{t('home.models.lead')}</p>
          <p>{t('home.trials.lead')}</p>
        </div>
      </div>
      <div class="bench__shell">
        <div class="bench__meters" id="bench-meters" aria-label={pick(lang, homeCopy.bench.metersLabel)}>
          <div><b data-meter="played">0</b><span>{pick(lang, homeCopy.bench.played)}</span></div>
          <div data-tone="ours"><b data-meter="ours">0</b><span>clavue-jev {pick(lang, homeCopy.bench.hits)}</span></div>
          <div><b data-meter="peer">0</b><span>jev-1.13.0 {pick(lang, homeCopy.bench.hits)}</span></div>
          <div><b data-meter="agree">0</b><span>{pick(lang, homeCopy.bench.agree)}</span></div>
        </div>
      <div class="bench__body">
        <nav class="bench__rail" aria-label={pick(lang, homeCopy.bench.railLabel)}>
          {trialGroups.map((group, index) => (
            <button type="button" data-cat={group.category} class={index === 0 ? 'is-on' : ''}>
              <span><picture><source srcset={`/img/icons/${group.category}.webp`} type="image/webp" /><img src={`/img/icons/${group.category}.png`} alt="" width="22" height="22" /></picture>{group.label}</span>
              <i>{group.items.length}</i>
            </button>
          ))}
        </nav>
        <div class="bench__stage" id="bench-stage" data-tone="wait">
          <div class="bench__stage-bar">
            <p class="bench__kicker" id="bench-kicker"></p>
            <div class="bench__switch" id="bench-switch"></div>
          </div>
          <h3 class="bench__ask" id="bench-question"></h3>
          <p class="bench__specimen" id="bench-title"></p>
          <pre id="bench-context"></pre>
          <p class="bench__verdict" id="bench-verdict" aria-live="polite"></p>
          <div class="bench__duel" id="bench-duel">
            <div data-side="ours">
              <div class="duel__label"><span>clavue-jev</span><b data-stamp></b></div>
              <p class="duel__choice" data-choice>—</p>
              <div class="duel__track"><i data-bar></i></div>
              <p class="duel__meta" data-meta></p>
            </div>
            <div data-side="peer">
              <div class="duel__label"><span>jev-1.13.0</span><b data-stamp></b></div>
              <p class="duel__choice" data-choice>—</p>
              <div class="duel__track"><i data-bar></i></div>
              <p class="duel__meta" data-meta></p>
            </div>
          </div>
          <div class="bench__actions">
            <button class="btn btn--primary" id="bench-run" type="button">{pick(lang, homeCopy.bench.runOne)}</button>
            <button class="btn btn--ghost" id="bench-run-cat" type="button">{t('home.trials.group')}</button>
            <a class="btn btn--ghost" href={`/${lang}/compare/`}>{t('home.trials.more')}</a>
            <a class="btn btn--ghost" href={`/${lang}/scenes/`}>{pick(lang, homeCopy.bench.scenesLink)}</a>
          </div>
          <p class="bench__promo">{t('home.models.promo')} <a href={`/${lang}/api/`}>{t('home.models.cta')}</a></p>
        </div>
        <aside class="bench__live" aria-live="polite">
          <h3>{t('home.trials.narration')}</h3>
          <p class="bench__now" id="bench-now">{t('home.trials.empty')}</p>
          <ol id="trial-narration"></ol>
        </aside>
      </div>
      </div>
    </div>
  </section>

  <section class="section scene-row">
    <div class="wrap">
      <div class="section__head">
        <h2 class="section__title">{pick(lang, homeCopy.sceneRow.title)}</h2>
        <p class="section__lead">{pick(lang, homeCopy.sceneRow.lead)}</p>
      </div>
      <div class="scene-row__grid">
        <a class="scene-card" href={`/${lang}/scenes/#tetris`}>
          <picture>
            <source srcset="/img/scenes/tetris.webp" type="image/webp" />
            <img src="/img/scenes/tetris.png" alt="" width="1200" height="686" loading="lazy" decoding="async" />
          </picture>
          <h3>{pick(lang, homeCopy.sceneRow.cards.tetris.title)}</h3>
          <p>{pick(lang, homeCopy.sceneRow.cards.tetris.desc)}</p>
        </a>
        <a class="scene-card" href={`/${lang}/scenes/#rapid`}>
          <picture>
            <source srcset="/img/scenes/rapid.webp" type="image/webp" />
            <img src="/img/scenes/rapid.png" alt="" width="1200" height="686" loading="lazy" decoding="async" />
          </picture>
          <h3>{pick(lang, homeCopy.sceneRow.cards.rapid.title)}</h3>
          <p>{pick(lang, homeCopy.sceneRow.cards.rapid.desc)}</p>
        </a>
        <a class="scene-card" href={`/${lang}/scenes/#sort`}>
          <picture>
            <source srcset="/img/scenes/sort.webp" type="image/webp" />
            <img src="/img/scenes/sort.png" alt="" width="1200" height="686" loading="lazy" decoding="async" />
          </picture>
          <h3>{pick(lang, homeCopy.sceneRow.cards.sort.title)}</h3>
          <p>{pick(lang, homeCopy.sceneRow.cards.sort.desc)}</p>
        </a>
      </div>
    </div>
  </section>

  <section class="stats">
    <div class="wrap">
      <div class="stats__grid">
        {stats.map((s) => (
          <div class="stat">
            <div class="stat__num">{s.num}</div>
            <div class="stat__label">{s.label}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--fresh">
    <div class="wrap">
      <div class="section__head">
        <h2 class="section__title">{t('home.whatsNew')}</h2>
        <p class="section__lead">{t('home.whatsNew.lead')}</p>
      </div>
      <div class="grid grid--3">
        <div class="fresh">
          <div class="fresh__head">
            <h3>{t('home.fresh.docs')}</h3>
            <a href={`/${lang}/introduction/`}>{t('home.viewAll')}</a>
          </div>
          <ul>
            {freshDocs.map((doc) => (
              <li>
                <a href={`/${lang}/${doc.id.replace(new RegExp(`^${lang}/`), '').replace(/\.md$/, '')}/`}>{doc.data.title}</a>
              </li>
            ))}
          </ul>
        </div>
        <div class="fresh">
          <div class="fresh__head">
            <h3>{t('home.fresh.community')}</h3>
            <a href={`/${lang}/community/`}>{t('home.viewAll')}</a>
          </div>
          <ul>
            {featuredPulse.map((entry) => (
              <li>
                <a href={`/${lang}/community/`}>{entry.author}: {entry.text.slice(0, 88)}…</a>
              </li>
            ))}
          </ul>
        </div>
        <div class="fresh">
          <div class="fresh__head">
            <h3>{t('home.fresh.projects')}</h3>
            <a href={`/${lang}/ecosystem/`}>{t('home.viewAll')}</a>
          </div>
          <ul>
            {featuredProjects.map((project) => (
              <li>
                <a href={project.url} target="_blank" rel="nofollow noopener noreferrer">
                  {project.repo} <span>★ {fmtStars(project.stars)}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section__head">
        <h2 class="section__title">{t('home.section.primitives.title')}</h2>
        <p class="section__lead">{t('home.section.primitives.lead')}</p>
      </div>
      <div class="grid grid--3">
        {primitiveCards.map((p) => (
          <a class="card" href={`/${lang}/primitives/${p.slug}/`}>
            <span class="card__badge">{p.label}</span>
            <h3 class="card__title">{p.tagline[lang]}</h3>
            <p class="card__desc">{p.desc[lang]}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section__head">
        <h2 class="section__title">{t('home.section.patterns.title')}</h2>
        <p class="section__lead">{t('home.section.patterns.lead')}</p>
      </div>
      <div class="grid grid--2">
        {patternCards.map((p) => (
          <a class="card" href={`/${lang}/patterns/${p.slug}/`}>
            <h3 class="card__title">{p.title[lang]}</h3>
            <p class="card__desc">{p.desc[lang]}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section__head">
        <h2 class="section__title">{t('home.section.ecosystem.title')}</h2>
        <p class="section__lead">{t('home.section.ecosystem.lead')}</p>
      </div>
      <div class="grid grid--4">
        {destinations.map((q) => (
          <a class="card" href={q.href}>
            <h3 class="card__title">{q.title}</h3>
            <p class="card__desc">{q.desc}</p>
          </a>
        ))}
      </div>
      <p style="margin-top:26px;color:var(--fg-dim);font-size:14.5px;">
        {t('home.docCount').replace('{n}', String(docsCount))}
      </p>
    </div>
  </section>

  <section class="section" id="library">
    <div class="wrap library">
      <div class="section__head">
        <h2 class="section__title">{pick(lang, homeCopy.library.title)}</h2>
        <p class="section__lead" set:html={pick(lang, homeCopy.library.lead).replaceAll('{lang}', lang)} />
      </div>
      <h3 class="library__faq">{pick(lang, homeCopy.library.faqTitle)}</h3>
      <div class="library__list">
        {faqs.map((item) => (
          <details>
            <summary>{item.q}</summary>
            <p>{item.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>
  <Cluster lang={lang} path={path} />
  <script type="application/json" id="bench-copy" is:inline set:html={JSON.stringify(pick(lang, homeCopy.benchClient)).replaceAll('<', '\\u003c')} />
  <script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema).replaceAll('<', '\\u003c')} />
</BaseLayout>

<style>
  .library__faq { margin: 8px 0 12px; font-size: 18px; }
  .library__list details {
    border-top: 1px solid var(--border);
    padding: 12px 0;
  }
  .library__list summary { cursor: pointer; font-weight: 600; }
  .library__list p { margin: 8px 0 0; color: var(--fg-muted); max-width: 68ch; }
  .library a { color: var(--accent-strong); }
</style>

<script>
  import { compareCases } from '../../data/compare-cases';

  const root = document.querySelector('.bench');
  const lang = document.documentElement.lang.split('-')[0];
  const zh = lang === 'zh';
  const injected = JSON.parse(document.getElementById('bench-copy')?.textContent || '{}');
  const copy = {
    ...injected,
    batch: (n, ours, peer) => (injected.batch || '{n}: {ours} / {peer}')
      .replace('{n}', String(n)).replace('{ours}', String(ours)).replace('{peer}', String(peer)),
  };

  const byId = new Map(compareCases.map((item) => [item.id, item]));
  const results = new Map();
  const narrations = [];
  const seen = new Set();
  const order = [...document.querySelectorAll('[data-cat]')].map((button) => button.getAttribute('data-cat'));
  let category = order[0] || 'urgency';
  let activeId = compareCases.find((item) => item.category === category)?.id || '';
  let busy = false;

  const switchEl = document.getElementById('bench-switch');
  const kickerEl = document.getElementById('bench-kicker');
  const titleEl = document.getElementById('bench-title');
  const questionEl = document.getElementById('bench-question');
  const contextEl = document.getElementById('bench-context');
  const verdictEl = document.getElementById('bench-verdict');
  const stageEl = document.getElementById('bench-stage');
  const nowEl = document.getElementById('bench-now');
  const narrationEl = document.getElementById('trial-narration');
  const runButton = document.getElementById('bench-run') as HTMLButtonElement | null;
  const catButton = document.getElementById('bench-run-cat') as HTMLButtonElement | null;

  function itemsIn(name) {
    return compareCases.filter((item) => item.category === name).slice(0, 5);
  }

  function hit(item, side) {
    return Boolean(side?.ok && item.accept.includes(side.choice));
  }

  function verdictFor(item, result) {
    if (!result) return { tone: 'wait', text: copy.waiting };
    const ours = hit(item, result.ours);
    const peer = hit(item, result.official);
    const oursOk = Boolean(result.ours?.ok);
    const peerOk = Boolean(result.official?.ok);
    const same = oursOk && peerOk && result.ours.choice === result.official.choice;
    const faster = oursOk && peerOk && Number(result.ours.ms) < Number(result.official.ms);
    if (!oursOk && !peerOk) return { tone: 'bad', text: copy.down };
    if (ours && !peer) return { tone: 'win', text: copy.win };
    if (ours && peer && faster) return { tone: 'win', text: copy.bothFast };
    if (ours && peer) return { tone: 'even', text: copy.both };
    if (!ours && peer) return { tone: 'lose', text: copy.lose };
    if (same) return { tone: 'even', text: copy.sameMiss };
    return { tone: 'split', text: copy.split };
  }

  function paintMeters() {
    const totals = { played: 0, ours: 0, peer: 0, agree: 0 };
    for (const [id, result] of results) {
      const item = byId.get(id);
      if (!item) continue;
      totals.played += 1;
      if (hit(item, result.ours)) totals.ours += 1;
      if (hit(item, result.official)) totals.peer += 1;
      if (result.ours?.ok && result.official?.ok && result.ours.choice === result.official.choice) totals.agree += 1;
    }
    for (const key of Object.keys(totals)) {
      const node = document.querySelector(`[data-meter="${key}"]`) as HTMLElement | null;
      if (!node) continue;
      const next = String(totals[key as keyof typeof totals]);
      if (node.textContent !== next) {
        node.textContent = next;
        node.classList.remove('is-tick');
        void node.offsetWidth;
        node.classList.add('is-tick');
      }
    }
  }

  function paintSide(panel, side, marked) {
    const choice = panel.querySelector('[data-choice]');
    const stamp = panel.querySelector('[data-stamp]');
    const bar = panel.querySelector('[data-bar]');
    const meta = panel.querySelector('[data-meta]');
    panel.classList.remove('is-hit', 'is-miss', 'is-running', 'is-empty');
    if (!side) {
      panel.classList.add('is-empty');
      if (choice) choice.textContent = '—';
      if (stamp) stamp.textContent = '';
      if (bar) bar.style.width = '0%';
      if (meta) meta.textContent = '';
      return;
    }
    if (!side.ok) {
      panel.classList.add('is-miss');
      if (choice) choice.textContent = copy.none;
      if (stamp) stamp.textContent = copy.none;
      if (bar) bar.style.width = '0%';
      if (meta) meta.textContent = side.error || '';
      return;
    }
    panel.classList.add(marked ? 'is-hit' : 'is-miss');
    const probability = side.probabilities?.[side.choice];
    const width = typeof probability === 'number' ? Math.round(probability * 100) : 0;
    if (choice) choice.textContent = side.choice;
    if (stamp) stamp.textContent = marked ? copy.hit : copy.miss;
    if (bar) bar.style.width = `${width}%`;
    if (meta) meta.textContent = `${width}% · ${Math.round(side.ms)} ms`;
  }

  function setTone(tone, flash) {
    if (!stageEl) return;
    stageEl.dataset.tone = tone;
    stageEl.classList.remove('is-flash');
    if (flash) {
      void stageEl.offsetWidth;
      stageEl.classList.add('is-flash');
    }
  }

  function setRunning(on) {
    stageEl?.classList.toggle('is-live', on);
    document.querySelectorAll('#bench-duel [data-side]').forEach((panel) => {
      panel.classList.toggle('is-running', on);
      if (on) {
        panel.classList.remove('is-hit', 'is-miss', 'is-empty');
        const choice = panel.querySelector('[data-choice]');
        const stamp = panel.querySelector('[data-stamp]');
        const bar = panel.querySelector('[data-bar]');
        if (choice) choice.textContent = '…';
        if (stamp) stamp.textContent = '';
        if (bar) (bar as HTMLElement).style.width = '42%';
      }
    });
    if (verdictEl && on) {
      verdictEl.hidden = false;
      verdictEl.className = 'bench__verdict is-wait';
      verdictEl.textContent = copy.running;
    }
    if (on) setTone('wait', false);
  }

  function paintStage() {
    const item = byId.get(activeId);
    if (!item) return;
    const label = document.querySelector(`[data-cat="${CSS.escape(category)}"] span`)?.textContent || item.category;
    if (kickerEl) kickerEl.textContent = label;
    if (titleEl) titleEl.textContent = item.title;
    if (questionEl) questionEl.textContent = item.question;
    if (contextEl) contextEl.textContent = item.context;
    document.querySelectorAll('[data-pick]').forEach((button) => {
      const id = button.getAttribute('data-pick');
      button.classList.toggle('is-on', id === activeId);
      const result = id ? results.get(id) : null;
      const known = id ? byId.get(id) : null;
      button.classList.toggle('is-hit', Boolean(known && result && hit(known, result.ours)));
      button.classList.toggle('is-miss', Boolean(known && result && result.ours?.ok && !hit(known, result.ours)));
    });
    const result = results.get(item.id);
    const verdict = verdictFor(item, result);
    if (verdictEl) {
      verdictEl.hidden = false;
      verdictEl.className = `bench__verdict is-${verdict.tone}`;
      verdictEl.textContent = verdict.text;
    }
    stageEl?.classList.remove('is-live');
    setTone(verdict.tone, verdict.tone === 'win');
    const oursPanel = document.querySelector('#bench-duel [data-side="ours"]');
    const peerPanel = document.querySelector('#bench-duel [data-side="peer"]');
    if (oursPanel) paintSide(oursPanel, result?.ours, result ? hit(item, result.ours) : false);
    if (peerPanel) paintSide(peerPanel, result?.official, result ? hit(item, result.official) : false);
  }

  function paintSwitch() {
    if (!switchEl) return;
    switchEl.replaceChildren();
    itemsIn(category).forEach((item, index) => {
      const button = document.createElement('button');
      button.type = 'button';
      button.dataset.pick = item.id;
      button.textContent = String(index + 1);
      button.title = item.title;
      switchEl.appendChild(button);
    });
    paintStage();
  }

  function when(ts) {
    const date = new Date(ts);
    if (Number.isNaN(date.getTime())) return '';
    return date.toLocaleString(zh ? 'zh-CN' : 'en', { hour12: false, month: '2-digit', day: '2-digit', hour: '2-digit', minute: '2-digit' });
  }

  function paintNarration() {
    if (!narrationEl) return;
    narrationEl.replaceChildren();
    for (const entry of narrations.slice(0, 12)) {
      const line = zh ? entry.narration?.zh : entry.narration?.en;
      const item = document.createElement('li');
      const time = document.createElement('time');
      time.textContent = when(entry.ts);
      item.append(time, document.createTextNode(line || ''));
      narrationEl.appendChild(item);
    }
    const latest = narrations[0];
    if (nowEl && latest) {
      nowEl.textContent = (zh ? latest.narration?.zh : latest.narration?.en) || '';
      nowEl.classList.remove('is-fresh');
      void nowEl.offsetWidth;
      nowEl.classList.add('is-fresh');
    }
  }

  function remember(list) {
    const fresh = [];
    for (const entry of list || []) {
      if (!entry?.narration) continue;
      const key = `${entry.ts}|${entry.id}`;
      if (seen.has(key)) continue;
      seen.add(key);
      fresh.push(entry);
    }
    if (!fresh.length) return;
    narrations.unshift(...fresh);
    paintNarration();
  }

  async function ask(items) {
    const response = await fetch('/api/compare', {
      method: 'POST',
      headers: { 'content-type': 'application/json' },
      body: JSON.stringify({
        items: items.map((item) => ({ id: item.id, context: item.context, question: item.question, choices: item.choices })),
      }),
    });
    const data = await response.json().catch(() => ({}));
    if (response.status === 429) throw new Error(copy.limit);
    if (!response.ok) throw new Error(data.error || `HTTP ${response.status}`);
    remember([].concat(data.recorded || []).reverse());
    return data.results || [];
  }

  async function runItems(items) {
    if (!items.length || busy) return;
    busy = true;
    if (runButton) runButton.disabled = true;
    if (catButton) catButton.disabled = true;
    setRunning(true);
    try {
      const rows = await ask(items);
      for (const result of rows) results.set(result.id, result);
      if (items.length > 1) {
        const ours = items.filter((item) => hit(item, results.get(item.id)?.ours)).length;
        const peer = items.filter((item) => hit(item, results.get(item.id)?.official)).length;
        const tone = ours > peer ? 'win' : ours < peer ? 'lose' : 'even';
        paintStage();
        if (verdictEl) {
          verdictEl.className = `bench__verdict is-${tone}`;
          verdictEl.textContent = copy.batch(items.length, ours, peer);
        }
        setTone(tone, tone === 'win');
      } else {
        paintStage();
      }
      paintMeters();
    } catch (err: any) {
      setRunning(false);
      if (verdictEl) {
        verdictEl.className = 'bench__verdict is-bad';
        verdictEl.textContent = err.message;
      }
      setTone('bad', false);
    } finally {
      busy = false;
      if (runButton) runButton.disabled = false;
      if (catButton) catButton.disabled = false;
    }
  }

  root?.addEventListener('click', (event) => {
    const target = event.target instanceof HTMLElement ? event.target : null;
    const cat = target?.closest('[data-cat]');
    if (cat instanceof HTMLButtonElement) {
      category = cat.getAttribute('data-cat') || category;
      document.querySelectorAll('[data-cat]').forEach((button) => button.classList.toggle('is-on', button === cat));
      activeId = itemsIn(category)[0]?.id || activeId;
      paintSwitch();
      return;
    }
    const pick = target?.closest('[data-pick]');
    if (pick instanceof HTMLButtonElement) {
      activeId = pick.getAttribute('data-pick') || activeId;
      paintStage();
    }
  });

  runButton?.addEventListener('click', () => {
    const item = byId.get(activeId);
    if (item) runItems([item]);
  });
  catButton?.addEventListener('click', () => runItems(itemsIn(category)));

  paintSwitch();
  fetch('/api/compare/recent?limit=12')
    .then((response) => (response.ok ? response.json() : null))
    .then((data) => remember(data?.entries))
    .catch(() => {});
</script>

