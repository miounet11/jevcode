# JevCode intake 服务环境变量
#
# 安装到 /etc/jevcode-intake.env，权限 0600、属主 root。
# 真实 token 绝不可提交进仓库：
#   install -m 600 -o root -g root intake.env.example /etc/jevcode-intake.env
#   # 然后编辑填入真实 token（生成：openssl rand -hex 32）

JEVCODE_INTAKE_TOKEN=REPLACE_WITH_openssl_rand_hex_32
JEVCODE_INTAKE_BIND=127.0.0.1
JEVCODE_INTAKE_PORT=8787
JEVCODE_INTAKE_INBOX=/var/lib/jevcode-intake/inbox
