[Unit]
Description=JevCode content intake endpoint
Documentation=file:/var/www/jevcode/current/../shared/intake/README.md
After=network.target

[Service]
Type=simple
User=jevcode-intake
Group=jevcode-intake
WorkingDirectory=/opt/jevcode-intake

# token 与监听参数由 root 写入此文件，权限 0600，仅本服务可读。
# 模板见 deploy/intake/intake.env.example
EnvironmentFile=/etc/jevcode-intake.env

ExecStart=/usr/bin/python3 /opt/jevcode-intake/server.py

# 加固：本服务只写 inbox，不需要任何额外能力
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

# 纯 Python HTTP 服务不需要任何 capability
CapabilityBoundingSet=
AmbientCapabilities=

# README 称"无出站请求"——这里在内核层强制：
# 只允许 loopback（nginx 经 127.0.0.1 反代进来），任何对外连接被丢包。
IPAddressDeny=any
IPAddressAllow=localhost
# 唯一可写路径
ReadWritePaths=/var/lib/jevcode-intake

# 落盘的采集内容可能含未公开素材，不给 other/group 读权限
UMask=0077

Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
